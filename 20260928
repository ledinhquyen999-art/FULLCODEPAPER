_EXTRACT = {"info": {}, "method": None}


def _low_envelope(P, k=None, pctl=None):
    k = ENV_WINDOW_SLOTS if k is None else k
    pctl = ENV_PCTL if pctl is None else pctl
    return np.array([np.percentile(P[max(0, t - k):min(N_SLOTS, t + k + 1)], pctl)
                     for t in range(N_SLOTS)])


def _pchip(x, y, xi):
    try:
        from scipy.interpolate import PchipInterpolator
        return PchipInterpolator(x, y, extrapolate=True)(xi)
    except Exception:
        return np.interp(xi, x, y)


def extract_edge(P, Q, trs, p_rated, n_units):
    """
    [V5] Bóc tách hai kênh (P, Q) - không cần trạm tham chiếu.
      1) Cạnh trên kênh Q: bơm là tải cảm, bật/tắt tạo bậc rõ trên Q (nếu Q là số đo thật).
      2) Cạnh trên kênh P: phần vượt đường bao phân vị thấp quá nửa công suất một tổ bơm.
      3) Tải nền: nội suy đơn điệu (PCHIP) qua các slot CHẮC CHẮN không bơm (đã xói mòn biên và
         loại các điểm neo nằm cao bất thường so với đường bao).
      4) Ràng buộc cứng: 0 <= P_base <= min(P_đo, 1,05 x TRs x cosφ) -> không bao giờ ΔP < 0.
    """
    idx = np.arange(N_SLOTS)
    s_all = np.hypot(P, Q)
    cos = np.where(s_all > 1e-9, P / np.maximum(s_all, 1e-9), np.nan)
    q_usable = float(np.nanstd(cos)) > Q_USABLE_COS_STD
    q_night = float(np.median(Q[NIGHT_SLOTS]))

    win = np.zeros(N_SLOTS, bool)
    win[ALLOWABLE_MIN:ALLOWABLE_MAX + 1] = True

    on_q = np.zeros(N_SLOTS, bool)
    q_amp = float(np.max(Q) - q_night)
    if q_usable and q_amp > 2.0:
        on_q = (Q - q_night) > max(Q_STEP_FRAC * q_amp, 2.0)
    env = _low_envelope(P)
    p_unit = (p_rated / n_units) if n_units else 0.0

    # [V5.1] Siết ngưỡng cạnh kênh P và GIAO hai kênh khi Q dùng được.
    # v5.0 dùng hợp (OR) nên bắt quá rộng: 9/18 trạm ra 14-16,5 giờ bơm/ngày, phi thực tế với
    # tưới cà phê. Ngoài ra ngưỡng được nâng dần cho tới khi số giờ bơm <= MAX_PUMP_HOURS.
    def _on_p(frac):
        thr = max(frac * p_unit, PUMP_DETECT_RATED * p_rated, 2.0) if p_rated > 0 else np.inf
        return (P - env) > thr

    on_p = _on_p(P_EDGE_FRAC)
    on_q &= win
    on_p &= win

    def _hyst(seed, cont):
        """Mở rộng mỗi khối 'seed' sang hai phía chừng nào 'cont' còn đúng (trễ hai chiều)."""
        out = seed.copy()
        for t in range(1, N_SLOTS):                      # về phía sau
            if out[t - 1] and cont[t]:
                out[t] = True
        for t in range(N_SLOTS - 2, -1, -1):             # về phía trước
            if out[t + 1] and cont[t]:
                out[t] = True
        return out

    def _combine(op):
        if not q_usable or not on_q.any():
            return op.copy()
        if CHANNEL_COMBINE == "or":
            return on_q | op
        seed = on_q & op
        if seed.sum() < MIN_WINDOW_SLOTS:               # giao quá chặt -> lùi về kênh Q
            seed = on_q.copy()
        return _hyst(seed, op) if CHANNEL_COMBINE == "hyst" else seed

    on = _combine(on_p)
    if p_rated <= 0:                     # [v9.7] trạm KHÔNG có bơm: không bóc gì (v9.5-v9.6 lùi về
        on = np.zeros(N_SLOTS, bool)     #   kênh Q và làm mất ~1.900 kWh/ngày của DC53DM05)
    agree = float(np.mean(on_q == on_p)) if q_usable else np.nan

    # trần số giờ bơm: siết dần ngưỡng kênh P (dùng CÙNG quy tắc kết hợp - v9.4 trở về trước luôn
    # ép về 'and' trong vòng lặp này, làm dải bất định and/or bị sai)
    frac = P_EDGE_FRAC
    while on.sum() * DT_H > MAX_PUMP_HOURS and frac < 6.0:
        frac *= 1.25
        on = _combine(_on_p(frac) & win)
        if p_rated <= 0:
            on = np.zeros(N_SLOTS, bool)
        if on.sum() < MIN_WINDOW_SLOTS:
            break

    # [v9.3] Khử nhiễu: bỏ các chuỗi 'đang bơm' ngắn hơn EDGE_MIN_ON_SLOTS (phần công suất đó trả về
    # tải nền, đẳng thức P_base + P_bơm = P_đo vẫn giữ nguyên).
    n_debounced = 0
    if EDGE_MIN_ON_SLOTS > 1:
        d_ = np.diff(np.concatenate([[0], on.astype(int), [0]]))
        for s0, s1 in zip(np.where(d_ == 1)[0], np.where(d_ == -1)[0]):
            if s1 - s0 < EDGE_MIN_ON_SLOTS:
                on[s0:s1] = False
                n_debounced += int(s1 - s0)

    off = ~on
    eroded = off.copy()
    for t in range(N_SLOTS):
        if off[t] and ((t > 0 and on[t - 1]) or (t < N_SLOTS - 1 and on[t + 1])):
            eroded[t] = False
    anchor = eroded & (P <= env * 1.10 + max(0.05 * p_rated, 2.0))
    for fb in (eroded, off, np.ones(N_SLOTS, bool)):
        if anchor.sum() >= 4:
            break
        anchor = fb

    base = _pchip(idx[anchor], P[anchor], idx)
    base = np.clip(base, 0.0, None)
    base = np.minimum(base, P)
    base = np.minimum(base, BASE_MAX_PU * trs * POWER_FACTOR)
    pump = np.maximum(0.0, P - base)
    if p_rated > 0:
        pump = np.minimum(pump, p_rated)
    # [V5.1] công suất bơm CHỈ tồn tại ở các slot được xác định là ĐANG BƠM
    pump = np.where(on, pump, 0.0)
    pump[~win] = 0.0
    base = P - pump

    units = (np.round(pump / p_unit).astype(int) if p_unit > 0 else np.zeros(N_SLOTS, int))
    units = np.clip(units, 0, n_units)
    units[~win] = 0
    return {"base": base, "pump": pump, "units": units, "on": on, "on_q": on_q, "on_p": on_p,
            "q_usable": q_usable, "agree": agree, "env": env, "n_debounced": n_debounced}


def _rainy_dir():
    """[v9.4] Thư mục ngày mùa mưa: RAINY_DIR nếu có, không thì thư mục con của INPUT có tên
    (bỏ dấu) chứa 'mua mua'/'rain'/'wet' và có file .xlsx."""
    if os.path.isdir(RAINY_DIR) and glob.glob(os.path.join(RAINY_DIR, "*.xlsx")):
        return RAINY_DIR
    if os.path.isdir(INPUT_DIR):
        for root, dirs, _ in os.walk(INPUT_DIR):
            for d in sorted(dirs):
                p = os.path.join(root, d)
                if _is_other_season(p) and glob.glob(os.path.join(p, "*.xlsx")):
                    return p
    return None


def _season_scale(P, P_rain, off):
    """Hệ số hiệu chỉnh mùa s = trung vị P_khô / P_mưa trên các slot CHẮC CHẮN không bơm."""
    m = off & (np.asarray(P_rain) > 1.0)
    if m.sum() < 4:
        return 1.0
    return float(np.clip(np.median(np.asarray(P)[m] / np.asarray(P_rain)[m]), 0.3, 3.0))


def extract_rainy_scaled(P, Q, P_rain, trs, p_rated, n_units):
    """
    [v9.4] Phương pháp đối chứng thứ hai: tải nền ngày khô = s·P_mưa(t), với s hiệu chỉnh khác biệt
    mùa trên các slot KHÔNG bơm (xác định bằng phương pháp cạnh). Công suất bơm = phần vượt trên
    đường nền đó, chỉ khi vượt ngưỡng một tổ bơm, trong khung Ω, khử nhiễu < 1 h, chặn trên bởi
    P_lắp. Đẳng thức P_base + P_bơm = P_đo vẫn giữ.
    """
    r0 = extract_edge(P, Q, trs, p_rated, n_units)
    sc = _season_scale(P, P_rain, ~r0["on"])
    base0 = np.minimum(sc * np.asarray(P_rain, float), P)
    win = np.zeros(N_SLOTS, bool); win[ALLOWABLE_MIN:ALLOWABLE_MAX + 1] = True
    p_unit = (p_rated / n_units) if n_units else 0.0
    thr = max(P_EDGE_FRAC * p_unit, PUMP_DETECT_RATED * p_rated, 2.0) if p_rated > 0 else np.inf
    on = ((P - base0) > thr) & win
    if EDGE_MIN_ON_SLOTS > 1:
        d_ = np.diff(np.concatenate([[0], on.astype(int), [0]]))
        for s0, s1 in zip(np.where(d_ == 1)[0], np.where(d_ == -1)[0]):
            if s1 - s0 < EDGE_MIN_ON_SLOTS:
                on[s0:s1] = False
    pump = np.where(on, np.clip(P - base0, 0.0, p_rated if p_rated > 0 else 0.0), 0.0)
    base = P - pump
    units = (np.round(pump / p_unit).astype(int) if p_unit > 0 else np.zeros(N_SLOTS, int))
    units = np.clip(units, 0, n_units); units[~win] = 0
    out = dict(r0)
    out.update({"base": base, "pump": pump, "units": units, "on": units > 0,
                "env": base0, "season_scale": sc})
    return out


def extract_from_reference_day(P, Q, P_ref, trs, p_rated, n_units):
    """Tải nền = số ĐO của ngày không tưới (mùa mưa) - phương án chính xác nhất."""
    base = np.minimum(np.asarray(P_ref, float), P)
    base = np.minimum(base, BASE_MAX_PU * trs * POWER_FACTOR)
    pump = np.maximum(0.0, P - base)
    win = np.zeros(N_SLOTS, bool)
    win[ALLOWABLE_MIN:ALLOWABLE_MAX + 1] = True
    if p_rated > 0:
        pump = np.minimum(pump, p_rated)
    pump[~win] = 0.0
    base = P - pump
    p_unit = (p_rated / n_units) if n_units else 0.0
    units = (np.round(pump / p_unit).astype(int) if p_unit > 0 else np.zeros(N_SLOTS, int))
    units = np.clip(units, 0, n_units); units[~win] = 0
    return {"base": base, "pump": pump, "units": units, "on": units > 0,
            "on_q": units > 0, "on_p": units > 0, "q_usable": True, "agree": np.nan,
            "env": base}


def extract_eq1(P, Q, f_tod, trs, p_rated, n_units):
    """Công thức (1) nguyên bản - giữ để đối chứng, KHÔNG khuyến nghị dùng."""
    base = np.maximum(float(np.mean(P[NIGHT_SLOTS])) * f_tod, 0.0)
    base = np.minimum(base, BASE_MAX_PU * trs * POWER_FACTOR)
    pump = np.maximum(0.0, P - base)
    win = np.zeros(N_SLOTS, bool); win[ALLOWABLE_MIN:ALLOWABLE_MAX + 1] = True
    thr = max(PUMP_DETECT_RATED * p_rated, 2.0) if p_rated > 0 else np.inf
    on = (pump > thr) & win
    pump = np.where(on, pump, 0.0)
    if p_rated > 0:
        pump = np.minimum(pump, p_rated)
    p_unit = (p_rated / n_units) if n_units else 0.0
    units = (np.round(pump / p_unit).astype(int) if p_unit > 0 else np.zeros(N_SLOTS, int))
    units = np.clip(units, 0, n_units)
    return {"base": P - pump, "pump": pump, "units": units, "on": on, "on_q": on, "on_p": on,
            "q_usable": False, "agree": np.nan, "env": base}


def build_fToD(p_ref):
    p_night = float(np.mean(p_ref[NIGHT_SLOTS]))
    if p_night <= 0:
        return np.ones(N_SLOTS)
    return np.maximum(p_ref / p_night, 0.05)


def build_system_data(spec, dry_dir):
    banner("[2] BÓC TÁCH TẢI NỀN (Eq.1) VÀ LỊCH BƠM HIỆN TRẠNG S2 (Eq.2)")

    meas, q_flags, metas = {}, [], {}
    for code in spec:
        p, q, hq, mt = read_etap_series(find_station_file(dry_dir, code))
        meas[code] = {"P": p, "Q": q}
        metas[code] = mt
        q_flags.append(hq)
    has_measured_q = all(q_flags)

    f_p = build_fToD(meas[REF_RESIDENTIAL]["P"])
    f_q = build_fToD(meas[REF_RESIDENTIAL]["Q"]) if has_measured_q else f_p

    # ---- Chọn phương pháp bóc tách -------------------------------------------------------------
    method = EXTRACTION_METHOD
    ref_day = {}
    rdir = _rainy_dir()
    if (USE_RAINY_AS_BASE or EXTRACTION_METHOD == "rainy_scaled") and rdir:
        method = "rainy_scaled" if EXTRACTION_METHOD == "rainy_scaled" else "rainy"
        for code in spec:
            f = find_station_file(rdir, code)
            if f:
                pr, qr, _, _ = read_etap_series(f)
                ref_day[code] = pr
        if len(ref_day) < len(spec):
            print(f" [!] Thư mục ngày không tưới thiếu {len(spec)-len(ref_day)} trạm -> "
                  f"quay lại phương pháp '{EXTRACTION_METHOD}'.")
            method = EXTRACTION_METHOD
    print(f" Phương pháp bóc tách tải nền: '{method}'"
          + ("  (tải nền = ngày mưa x hệ số hiệu chỉnh mùa - phương pháp đối chứng)"
             if method == "rainy_scaled" else
             "  (tải nền = SỐ ĐO ngày không tưới)" if method == "rainy" else
             "  (cạnh hai kênh P,Q - không cần trạm tham chiếu)" if method == "edge" else
             "  (công thức (1) nguyên bản - chỉ để đối chứng)"))

    stations, extract_info = {}, {}
    for code, s in spec.items():
        p_meas, q_meas = meas[code]["P"], meas[code]["Q"]
        s_meas = np.hypot(p_meas, q_meas)
        p_rated, n_units = s["P_pump"], int(s["n_units"])

        if method == "rainy_scaled" and code in ref_day:
            r = extract_rainy_scaled(p_meas, q_meas, ref_day[code], s["TRs"], p_rated, n_units)
        elif method == "rainy" and code in ref_day:
            r = extract_from_reference_day(p_meas, q_meas, ref_day[code],
                                           s["TRs"], p_rated, n_units)
        elif method == "eq1":
            r = extract_eq1(p_meas, q_meas, f_p, s["TRs"], p_rated, n_units)
        else:
            r = extract_edge(p_meas, q_meas, s["TRs"], p_rated, n_units)
        extract_info[code] = r

        p_base = r["base"]
        x_S2 = r["units"].astype(int)
        active = x_S2 > 0

        # Q của phần bơm: lấy từ SỐ ĐO thật trên các slot bơm
        if p_rated > 0 and active.sum() >= 2 and r["q_usable"]:
            q_off = float(np.median(q_meas[~active])) if (~active).any() else 0.0
            dq = np.maximum(0.0, q_meas - q_off)
            q_base = q_meas - np.where(active, dq, 0.0)
            with np.errstate(divide="ignore", invalid="ignore"):
                ratio = np.median(dq[active] / np.maximum(r["pump"][active], 1e-9))
            ratio = float(np.clip(ratio, 0.10, 1.20))
        else:
            ratio = Q_P_RATIO
            q_base = q_meas - np.where(active, r["pump"] * ratio, 0.0)
        q_base = np.clip(q_base, 0.0, None)

        p_pump_meas = float(np.max(r["pump"])) if p_rated > 0 else 0.0
        p_unit = (p_rated / n_units) if n_units else 0.0
        q_unit = p_unit * ratio
        s_unit = np.hypot(p_unit, q_unit)
        p_pump = p_unit * n_units
        q_pump = q_unit * n_units
        s_pump = np.hypot(p_pump, q_pump)

        det = {"thr": 0.0, "delta_max": p_pump_meas, "delta_p95": 0.0,
               "n_slot": int(active.sum()),
               "P_pump_meas": p_pump_meas, "E_pump": float(np.sum(r["pump"]) * DT_H),
               "agree": r["agree"], "q_usable": r["q_usable"],
               "base_ok": bool(np.all(p_base <= p_meas + 1e-6)),
               "base_cap_ok": bool(np.all(p_base <= BASE_MAX_PU * s["TRs"] * POWER_FACTOR + 1e-6))}

        stations[code] = {
            "code": code, "name": s["name"], "TRs": s["TRs"], "n_units": n_units,
            "P_pump": p_pump, "Q_pump": q_pump, "S_pump": s_pump,
            "p_unit": p_unit, "q_unit": q_unit, "s_unit": s_unit,
            "cosphi_pump": (p_pump / s_pump) if s_pump > 0 else np.nan,
            "P_base": p_base, "Q_base": q_base, "S_base": np.hypot(p_base, q_base),
            "N_slot_S2": int(active.sum()), "W_units": int(x_S2.sum()), "x_S2": x_S2,
            "P_meas": p_meas, "Q_meas": q_meas, "S_meas": s_meas, "Thr": 0.0, "detect": det,
            "peak_pct_meas": float(np.max(s_meas) / s["TRs"] * 100.0),
            "s_pump_over_trs": s_pump / s["TRs"] * 100.0 if s_pump > 0 else 0.0,
        }
    # [V5.1] Dải bất định của khâu bóc tách: chạy lại với chế độ kết hợp kênh còn lại
    if method == "edge":
        global CHANNEL_COMBINE
        keep_c = CHANNEL_COMBINE
        alt = "and" if keep_c != "and" else "hyst"
        CHANNEL_COMBINE = alt
        e_alt, e_alt_st = 0.0, {}
        for code, sp in spec.items():
            if sp["P_pump"] <= 0:
                continue
            ra = extract_edge(meas[code]["P"], meas[code]["Q"], sp["TRs"],
                              sp["P_pump"], int(sp["n_units"]))
            e_alt_st[code] = float(np.sum(ra["pump"]) * DT_H)
            e_alt += e_alt_st[code]
        CHANNEL_COMBINE = keep_c
        _EXTRACT["E_alt"] = e_alt
        _EXTRACT["E_alt_st"] = e_alt_st
        _EXTRACT["alt_mode"] = alt
    _EXTRACT["info"] = extract_info
    # [v9.7] BẢO TOÀN SO VỚI SỐ ĐO: mô hình S2 phải tái tạo công suất đo của từng trạm, sai khác chỉ
    # do làm tròn số tổ (<= 0,5 công suất một tổ); trạm không bơm phải khớp tuyệt đối.
    worst, e_mod, e_meas = [], 0.0, 0.0
    for c, st in stations.items():
        pm = np.asarray(st["P_meas"], float)
        pmod = np.asarray(st["P_base"], float) + np.asarray(st["x_S2"], float) * st["p_unit"]
        tol = (0.5 * st["p_unit"] if st["P_pump"] > 0 else 0.0) + 1e-6
        dev = float(np.max(np.abs(pmod - pm)))
        e_mod += float(np.sum(pmod) * DT_H); e_meas += float(np.sum(pm) * DT_H)
        if dev > tol:
            worst.append(f"{c} ({dev:.2f} kW > {tol:.2f})")
    if worst:
        raise SystemExit(" [LỖI BẢO TOÀN] Mô hình S2 không tái tạo số đo tại: " + ", ".join(worst))
    print(f" [+] BẢO TOÀN SỐ ĐO: mô hình S2 tái tạo công suất đo của cả {len(stations)} TBA "
          f"(sai khác chỉ do làm tròn số tổ); điện năng mô hình {e_mod:,.0f} / đo {e_meas:,.0f} kWh "
          f"({(e_mod - e_meas) / max(e_meas, 1e-9) * 100:+.2f}%).")
    _EXTRACT["method"] = method

    loads_ind = {}
    for code in RADIAL_CODES:
        f = find_station_file(dry_dir, code)
        if f:
            p, q, _, mt = read_etap_series(f)
            metas[code] = mt
        else:
            p, q = np.zeros(N_SLOTS), np.zeros(N_SLOTS)
        loads_ind[code] = {"P": p, "Q": q}
    others = {"loads": loads_ind}

    hdr = (f"{'Mã TBA':10s} {'Tên trạm':20s} {'TRs':>6s} {'n_tổ':>5s} {'P_bơm':>8s} "
           f"{'cosφ_bơm':>9s} {'S_p/TRs':>8s} {'W(tổ-slot)':>11s} {'Đỉnh S2':>9s}")
    print(hdr); print("-" * len(hdr))
    for st in stations.values():
        cp = f"{st['cosphi_pump']:.3f}" if st['P_pump'] > 0 else "-"
        print(f"{st['code']:10s} {st['name']:20s} {st['TRs']:6.0f} {st['n_units']:5d} "
              f"{st['P_pump']:8.1f} {cp:>9s} {st['s_pump_over_trs']:7.1f}% "
              f"{st['W_units']:11d} {st['peak_pct_meas']:8.1f}%")
    print("-" * len(hdr))

    df_fp = diagnose_dataset(stations, others, metas, spec)
    return stations, others, metas, df_fp


