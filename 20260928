def statistics_and_ablation(stations, others, pv_central, load_peak_guard=None):
    banner("[STAT] ABLATION GHÉP CẶP TRÊN CÙNG TẬP ỨNG VIÊN + KIỂM ĐỊNH WILCOXON")
    print(" Thiết kế: seed lấy mẫu pool CỐ ĐỊNH = %d (mọi cấu hình dùng CÙNG không gian nghiệm);"
          % POOL_SEED)
    print(" chỉ seed thuật toán thay đổi -> so sánh ghép cặp. Bài toán: cấu hình S3.\n")
    modes = [("greedy", "Greedy thuần tuý [1]"), ("grasp", "GRASP (RCL)"),
             ("grasp_sa", "GRASP + SA"), ("full", "GRASP + SA + Tabu")]
    raw, times, gains_map = {}, {}, {}
    for mode, label in modes:
        vals, tt, gains = [], [], []
        for sd in SEED_LIST:
            t0 = time.time()
            _, J, _, _ = run_optimizer(stations, others, pv_central, seed=sd, mode=mode,
                                       verbose=False, load_peak_guard=load_peak_guard)
            vals.append(J); tt.append(time.time() - t0); gains.append(LAST_RUN["ls_gain"])
        raw[label] = np.array(vals); times[label] = float(np.mean(tt))
        gains_map[label] = float(np.mean(gains))

    base_label = modes[0][1]
    base = raw[base_label]
    rows = []
    try:
        from scipy.stats import wilcoxon
        have_scipy = True
    except Exception:
        have_scipy = False
    for _, label in modes:
        v = raw[label]
        d = base - v
        if label == base_label or np.allclose(d, 0):
            p = np.nan
        elif have_scipy:
            try:
                p = float(wilcoxon(base, v, zero_method="zsplit").pvalue)
            except Exception:
                p = np.nan
        else:
            p = np.nan
        rows.append({"Cấu hình": label, "N_seed": len(SEED_LIST),
                     "J_mean": round(float(v.mean()), 4), "J_std": round(float(v.std()), 4),
                     "J_best": round(float(v.min()), 4), "J_worst": round(float(v.max()), 4),
                     "Δ vs Greedy (%)": round(float(d.mean() / abs(base.mean()) * 100), 4),
                     "Số seed tốt hơn": int(np.sum(d > 1e-9)),
                     "p (Wilcoxon)": ("-" if np.isnan(p) else f"{p:.4f}"),
                     "Cải thiện của local search": round(gains_map[label], 5),
                     "t (s)": round(times[label], 1)})
    df = pd.DataFrame(rows)
    print(df.to_string(index=False))
    print("\n [i] Greedy (α=0) là TẤT ĐỊNH trên pool cố định -> J_std = 0 là ĐÚNG, không phải lỗi.")
    print(" [i] Mọi cải thiện phải đọc cùng p-value; p > 0,05 thì KHÔNG được tuyên bố khung lai")
    print("     tốt hơn Greedy.")
    eff = (base.mean() - raw[modes[-1][1]].mean()) / abs(base.mean()) * 100
    if abs(eff) < 0.1:
        print(f" [!] Cải thiện tổng cộng chỉ {eff:.4f}% -> đóng góp thuật toán là THỨ YẾU; đóng")
        print("     góp chính nằm ở cách phát biểu bài toán (số tổ, ĐMT, PV áp mái, tuổi thọ).")
    return df, raw


def milp_benchmark(stations, others, pv_central, pool_cap=None, incumbent=None):
    """
    [L12] Chuẩn đối sánh bằng MILP (HiGHS qua scipy.optimize.milp), KHÔNG cần pulp.
    Cực tiểu ĐỈNH P_sys trên KHÔNG GIAN THU HẸP (mỗi trạm giữ pool_cap ứng viên tốt nhất theo
    đỉnh cục bộ). Đây là chặn dưới hợp lệ cho không gian thu hẹp đó, dùng để báo cáo GAP.
    """
    banner("[MILP] CHUẨN ĐỐI SÁNH TỐI ƯU TOÀN CỤC (HiGHS)")
    pool_cap = MILP_POOL_CAP if pool_cap is None else pool_cap
    try:
        from scipy.optimize import milp, LinearConstraint, Bounds
        from scipy.sparse import lil_matrix
    except Exception as e:
        print(f" [i] Không dùng được scipy.optimize.milp ({e}) -> bỏ qua.")
        return None

    active, pools, _, _, _ = build_candidate_pools(stations, verbose=False)
    p_fixed = np.sum([o["P"] for o in others["loads"].values()], axis=0) - pv_central
    for st in stations.values():
        p_fixed = p_fixed + st["P_base"]

    # [N7] LẤY MẪU PHÂN TẦNG theo mức số tổ m, cộng với việc NẠP SẴN lời giải của metaheuristic.
    # v3.0 lấy pool_cap ứng viên có đỉnh cục bộ nhỏ nhất -> tập con gần như đồng nhất (đều trải
    # mỏng tối đa), triệt tiêu tính đa dạng mà bài toán cần để san bằng ở cấp hệ thống, khiến
    # GAP ra ÂM và vô nghĩa. Nạp sẵn lời giải hiện có bảo đảm MILP không bao giờ tệ hơn nó.
    rng_s = np.random.default_rng(POOL_SEED)
    sub = {}
    for c in active:
        pool = pools[c]
        levels = {}
        for k, cand in enumerate(pool):
            levels.setdefault(int(np.max(cand)), []).append(k)
        per = max(1, pool_cap // max(len(levels), 1))
        idx = []
        for m, ks in sorted(levels.items()):
            take = min(per, len(ks))
            idx += list(rng_s.choice(ks, take, replace=False))
        rest = [k for k in range(len(pool)) if k not in set(idx)]
        if len(idx) < pool_cap and rest:
            idx += list(rng_s.choice(rest, min(pool_cap - len(idx), len(rest)), replace=False))
        sub[c] = [pool[i] for i in idx[:pool_cap]]
        if incumbent is not None and c in incumbent:
            inc = np.asarray(incumbent[c], np.int16)
            if not any(np.array_equal(inc, x) for x in sub[c]):
                sub[c][-1] = inc                       # nạp sẵn lời giải metaheuristic

    cols, meta = 0, []
    for c in active:
        for k in range(len(sub[c])):
            meta.append((c, k)); cols += 1
    n = cols + 1                                     # + biến Peak
    klim = kstart_limit()

    A_eq = lil_matrix((len(active), n)); b_eq = np.ones(len(active))
    for i, c in enumerate(active):
        for j, (cc, k) in enumerate(meta):
            if cc == c:
                A_eq[i, j] = 1.0

    A_ub = lil_matrix((2 * N_SLOTS, n))
    b_ub = np.zeros(2 * N_SLOTS)
    for t in range(N_SLOTS):
        for j, (c, k) in enumerate(meta):
            A_ub[t, j] = float(sub[c][k][t] * stations[c]["p_unit"])
        A_ub[t, cols] = -1.0
        b_ub[t] = -float(p_fixed[t])
        for j, (c, k) in enumerate(meta):
            v = start_kva_of(sub[c][k], stations[c]["s_unit"]) if K_START_MODE == "kva" \
                else starts_of(sub[c][k]).astype(float)
            A_ub[N_SLOTS + t, j] = float(v[t])
        b_ub[N_SLOTS + t] = klim

    cvec = np.zeros(n); cvec[cols] = 1.0
    integrality = np.ones(n); integrality[cols] = 0
    lb = np.zeros(n); ub = np.ones(n); ub[cols] = np.inf
    cons = [LinearConstraint(A_eq.tocsr(), b_eq, b_eq),
            LinearConstraint(A_ub.tocsr(), -np.inf, b_ub)]
    t0 = time.time()
    res = milp(c=cvec, constraints=cons, integrality=integrality,
               bounds=Bounds(lb, ub),
               options={"time_limit": MILP_TIME_LIMIT, "disp": False})
    dt = time.time() - t0
    if not res.success or res.x is None:
        print(f" [i] MILP không có nghiệm khả thi/hết thời gian ({res.message}).")
        return {"status": res.message, "peak_kw": None, "time_s": dt}
    peak = float(res.x[cols])
    lb_trivial = float(np.max(p_fixed))       # [v9 F8] đỉnh khi KHÔNG trạm nào bơm (tải nền)
    print(f" [+] Trạng thái: {res.message} | thời gian {dt:.1f} s | "
          f"{cols:,} biến nhị phân (pool cắt còn {pool_cap}/trạm)")
    print(f" [+] Đỉnh P_sys tối ưu trên không gian thu hẹp = {peak:,.1f} kW")
    print(f" [i] Cận dưới tầm thường (đỉnh tải nền, không trạm nào bơm) = {lb_trivial:,.1f} kW")
    if abs(peak - lb_trivial) < 0.5:
        print("     [!] Tối ưu MILP TRÙNG cận dưới tầm thường: đỉnh do tải nền quyết định, lịch nào")
        print("         né được khung giờ đó cũng đạt. GAP = 0 KHÔNG chứng minh chất lượng thuật")
        print("         toán; chỉ báo cáo như kiểm tra tính nhất quán.")
    print(" [i] Đây là chuẩn đối sánh cho ĐỈNH trên KHÔNG GIAN THU HẸP (mỗi trạm giữ "
          f"{pool_cap} ứng viên).")
    print("     Nếu GAP ra ÂM, điều đó KHÔNG có nghĩa metaheuristic vượt tối ưu toàn cục, mà")
    print("     nghĩa là không gian thu hẹp của MILP đã loại mất lời giải tốt -> hãy tăng")
    print("     MILP_POOL_CAP rồi chạy lại trước khi báo cáo con số này.")
    return {"status": str(res.message), "peak_kw": peak, "time_s": dt, "n_bin": cols,
            "lb_trivial": lb_trivial}


