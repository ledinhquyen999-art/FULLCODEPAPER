def tariff_vectors():
    tou = np.full(N_SLOTS, TARIFF_NORMAL)
    for t in range(N_SLOTS):
        h = t * DT_H
        if h >= 22.0 or h < 4.0:
            tou[t] = TARIFF_OFFPEAK
        elif (9.5 <= h < 11.5) or (17.0 <= h < 20.0):
            tou[t] = TARIFF_PEAK
    flat = np.full(N_SLOTS, TARIFF_IRRIGATION)
    return {"tou": tou, "irrigation_flat": flat}


def pump_bill(stations, sched, tariff):
    return float(sum(np.sum(np.asarray(sched[c]) * st["p_unit"] * DT_H * tariff)
                     for c, st in stations.items() if st["P_pump"] > 0))


def npv(cfs, rate=DISCOUNT_RATE):
    return float(sum(cf / (1 + rate) ** i for i, cf in enumerate(cfs)))


def _tr_cost(trs, table):
    """Giá theo dung lượng: lấy mốc nhỏ nhất >= TRs trong bảng (hoặc mốc lớn nhất)."""
    ks = sorted(table)
    k = next((k for k in ks if k >= trs - 1e-6), ks[-1])
    return table[k]


def bill_of(nets, tariff, stations):
    """Tiền điện mua từ lưới của các trạm có bơm (VNĐ/ngày) = Σ_i Σ_t P_net,i(t)·giá(t)·Δt.
    Tính trên P_net (đã trừ PV áp mái tự dùng) nên phản ánh cả dịch giờ bơm lẫn PV áp mái."""
    return float(sum(np.sum(np.maximum(nets[c]["p_net"], 0.0) * tariff) * DT_H
                     for c, st in stations.items() if st["P_pump"] > 0))


def loss_kwh_day(P_sys, p_ref):
    """[v9 F7] Tổn thất kỹ thuật xuất tuyến tỉ lệ bình phương dòng: ΔP(t) = r·P_ref·(P/P_ref)²
    (kW), với r = LOSS_RATE_FEEDER là tỉ lệ tổn thất ở P_ref. v8 thiếu thừa số P_ref."""
    p = np.abs(np.asarray(P_sys, float))
    return float(np.sum(LOSS_RATE_FEEDER * p_ref * (p / max(p_ref, 1e-9)) ** 2) * DT_H)


def ageing_value_vnd_year(stations, nets_ref, nets_new):
    """[v9 F7] Giá trị tuổi thọ MBA: Σ_i C_thay(TRs_i)·(L_i,ref − L_i,new)·N_ngày / L_chuẩn.
    Chỉ tính cho số ngày mùa khô (các ngày còn lại hai phương án như nhau)."""
    v = 0.0
    for c, st in stations.items():
        if c not in nets_ref or c not in nets_new:
            continue
        l0 = iec_hotspot(nets_ref[c]["s_net"], st["TRs"])["LoL_h_day"]
        l1 = iec_hotspot(nets_new[c]["s_net"], st["TRs"])["LoL_h_day"]
        v += _tr_cost(st["TRs"], COST_TR_REPLACE) * (l0 - l1) * DRY_SEASON_DAYS / LIFE_NORMAL_H
    return v


def cost_benefit(stations, upgrade_list, res_by_scen, roof_kwp_total=0.0):
    """
    PA1 - Nâng cấp MBA theo kết luận của mô hình nhị phân [1]      (so với S2)
    PA2 - Chỉ điều độ lịch bơm, lời giải khuyến nghị S3A            (so với S2)
    PA3 - Điều độ + PV áp mái, lời giải khuyến nghị S4A             (so với S2)
    Lợi ích tách thành phần: tiền điện, tổn thất xuất tuyến, tuổi thọ MBA. NPV 20 năm, 8%.
    """
    banner("[CBA] PHÂN TÍCH CHI PHÍ - LỢI ÍCH")
    n_ctrl = len([c for c in stations if stations[c]["P_pump"] > 0])
    capex_pa1 = sum(_tr_cost(stations[c]["TRs"] + 1, COST_TR_UPGRADE) for c in upgrade_list)
    ben_pa1 = 0.0
    for c in upgrade_list:
        trs = stations[c]["TRs"]
        nxt = next((k for k in sorted(COST_TR_UPGRADE) if k > trs), max(COST_TR_UPGRADE))
        ben_pa1 += 0.012 * trs * (1 - (trs / nxt) ** 2) * 8760 * 0.35 * TARIFF_AVG
    capex_ctrl = COST_CONTROL_PER_ST * n_ctrl
    capex_pv = COST_PV_PER_KWP * roof_kwp_total
    p_ref = float(np.max(res_by_scen["S2"]["P_sys"]))

    rows = []
    for mode, tariff in tariff_vectors().items():
        if TARIFF_MODE not in ("both", mode):
            continue
        b2 = bill_of(res_by_scen["S2"]["nets"], tariff, stations)
        l2 = loss_kwh_day(res_by_scen["S2"]["P_sys"], p_ref)
        options = [("PA1 - Nâng cấp MBA ([1])", capex_pa1, None, "ĐL chi / ĐL hưởng")]
        if "S3A" in res_by_scen:
            options.append(("PA2 - Điều độ lịch bơm (S3A)", capex_ctrl, "S3A",
                            "ĐL chi / DÂN hưởng tiền điện, ĐL hưởng tuổi thọ MBA"))
        if "S4A" in res_by_scen and capex_pv > 0:
            options.append(("PA3 - Điều độ + PV áp mái (S4A)", capex_ctrl + capex_pv, "S4A",
                            "chủ đầu tư PV hưởng tiền điện, ĐL hưởng tuổi thọ MBA"))
        for nm, capex, key, who in options:
            if key is None:
                d_bill = d_loss = d_age = 0.0
                annual = ben_pa1
            else:
                r = res_by_scen[key]
                d_bill = (b2 - bill_of(r["nets"], tariff, stations)) * DRY_SEASON_DAYS
                d_loss = (l2 - loss_kwh_day(r["P_sys"], p_ref)) * DRY_SEASON_DAYS * TARIFF_AVG
                d_age = ageing_value_vnd_year(stations, res_by_scen["S2"]["nets"], r["nets"])
                annual = d_bill + d_loss + d_age
            pv_part = capex_pv if key == "S4A" else 0.0
            cfs = [-capex]
            for y in range(1, PROJECT_LIFE_YR + 1):
                # suy giảm PV chỉ áp lên phần tiền điện do PV áp mái tạo ra (xấp xỉ bảo thủ:
                # áp lên toàn bộ phần tiền điện của PA3)
                deg = (1 - DEGRADATION_PV) ** (y - 1) if pv_part > 0 else 1.0
                ann_y = (d_bill * deg + d_loss + d_age) if key is not None else annual
                cfs.append(ann_y - COST_OM_RATE * capex)
            v = npv(cfs)
            pb = capex / annual if annual > 0 else np.inf
            rows.append({"Biểu giá": mode, "Phương án": nm,
                         "CAPEX (tr.VNĐ)": round(capex / 1e6, 1),
                         "Tiền điện/năm (tr.VNĐ)": round(d_bill / 1e6, 1),
                         "Tổn thất/năm (tr.VNĐ)": round(d_loss / 1e6, 1),
                         "Tuổi thọ MBA/năm (tr.VNĐ)": round(d_age / 1e6, 1),
                         "Lợi ích/năm (tr.VNĐ)": round(annual / 1e6, 1),
                         "NPV 20 năm (tr.VNĐ)": round(v / 1e6, 1),
                         "Hoàn vốn giản đơn (năm)": (round(pb, 1) if np.isfinite(pb) and pb < 100
                                                     else "—"),
                         "Chủ thể": who})
    df = pd.DataFrame(rows)
    print(f" {'Biểu giá':16s} {'Phương án':34s} {'CAPEX':>9s} {'Tiền điện':>10s} {'Tổn thất':>9s} "
          f"{'Tuổi thọ':>9s} {'Lợi ích':>9s} {'NPV 20n':>10s} {'Hoàn vốn':>9s}")
    print(f" {'':16s} {'':34s} {'(tr.đ)':>9s} {'(tr.đ/n)':>10s} {'(tr.đ/n)':>9s} {'(tr.đ/n)':>9s} "
          f"{'(tr.đ/n)':>9s} {'(tr.đ)':>10s} {'(năm)':>9s}")
    for _, r in df.iterrows():
        print(f" {r['Biểu giá']:16s} {r['Phương án']:34s} {r['CAPEX (tr.VNĐ)']:9,.1f} "
              f"{r['Tiền điện/năm (tr.VNĐ)']:10,.1f} {r['Tổn thất/năm (tr.VNĐ)']:9,.1f} "
              f"{r['Tuổi thọ MBA/năm (tr.VNĐ)']:9,.1f} {r['Lợi ích/năm (tr.VNĐ)']:9,.1f} "
              f"{r['NPV 20 năm (tr.VNĐ)']:10,.1f} {str(r['Hoàn vốn giản đơn (năm)']):>9s}")
    print("   Chủ thể: " + "; ".join(sorted(set(f"{r['Phương án'].split(' - ')[0]}: {r['Chủ thể']}"
                                              for _, r in df.iterrows()))))
    print("\n [!] CẢNH BÁO BẮT BUỘC ĐƯA VÀO BÀI:")
    print("   1. Giá bán lẻ cho bơm nước tưới tiêu thường KHÔNG phân giờ -> lợi ích tiền điện do DỊCH")
    print("      GIỜ bơm bằng 0 (hàng 'irrigation_flat'); PV áp mái vẫn giảm tiền điện do giảm điện")
    print("      mua. PHẢI tra đúng hợp đồng mua bán điện của các trạm.")
    print("   2. LỆCH CHỦ THỂ: tiền điện thuộc người dân/chủ đầu tư PV, tuổi thọ MBA và tổn thất thuộc")
    print("      Điện lực. Không có cơ chế chia sẻ lợi ích thì NPV > 0 chưa đủ để triển khai.")
    print("   3. Đơn giá ở mục 1.10 và giá thay MBA COST_TR_REPLACE là THAM KHẢO.")
    print("   4. Giá trị tuổi thọ tính theo tuổi thọ chuẩn IEC 180 000 h và chỉ số ngày mùa khô.")
    return df


