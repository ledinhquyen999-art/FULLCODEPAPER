# 9. TỔNG HỢP CÔNG SUẤT HỆ THỐNG
# =================================================================================================
def feeder_profile(stations, others, sched, pv_central, pv_roof=None):
    """P, Q, S tại nút nguồn (18)-(19). Trả thêm tổng PV áp mái tự dùng (để dựng phụ tải thật)."""
    P = np.sum([o["P"] for o in others["loads"].values()], axis=0) - np.asarray(pv_central, float)
    Q = np.sum([o["Q"] for o in others["loads"].values()], axis=0)
    nets, roof_used = {}, np.zeros(N_SLOTS)
    for c, st in stations.items():
        n = station_net(st, sched[c], (pv_roof or {}).get(c))
        nets[c] = n
        P = P + n["p_net"]; Q = Q + n["q_net"]; roof_used = roof_used + n["pv_used"]
    return P, Q, np.hypot(P, Q), nets, roof_used


