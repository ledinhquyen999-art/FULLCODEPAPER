_RELAXED = {}          # [v9] trạm buộc phải nới ràng buộc khi sinh ứng viên (được báo cáo)


def _unit_bounds(n_units):
    """Số tổ tối thiểu khi đang chạy (R4)."""
    if not UNIT_COMMITMENT:
        return n_units
    return max(1, int(np.ceil(MIN_UNIT_FRACTION * n_units)))


def _block_levels(W_units, L):
    """[v9 F3] Rải W tổ-slot lên L slot với mức GẦN ĐỀU {⌊W/L⌋+1, ⌊W/L⌋}: mức cao đặt trước.
    Hai mức chỉ chênh 1 tổ -> không có slot 'dư' nhỏ vi phạm (R4) như v8."""
    b, e = divmod(int(W_units), int(L))
    return np.array([b + 1] * e + [b] * (L - e), dtype=np.int16)


def generate_candidates(W_units, n_units, code=None):
    """
    Sinh tập lịch ứng viên X_i thoả (R1)-(R5), BẢO TOÀN NƯỚC TUYỆT ĐỐI Σ_t x_i(t) = W_i.

    Mô hình số tổ (UNIT_COMMITMENT=True) - tham số hoá theo TỔNG ĐỘ DÀI BƠM L (slot):
        L ∈ [ max(MIN_WINDOW, ⌈W/n⌉) ,  min(MAX_PUMP_SLOTS_DAY, |Ω|, ⌊W/m_min⌋) ]
        mức từng slot ∈ {⌊W/L⌋, ⌊W/L⌋+1} ⊂ [m_min, n]   (R4 thoả ở MỌI slot)
      rồi đặt L slot đó thành 1 ca (L <= MAX_WINDOW) hoặc 2 ca (mỗi ca trong [MIN, MAX]_WINDOW,
      nghỉ >= GAP_SLOTS), trượt qua mọi vị trí hợp lệ trong Ω.
    Mô hình nhị phân của [1] (UNIT_COMMITMENT=False): cả cụm bật/tắt cùng lúc, mức n_i; nếu W
      không chia hết cho n_i thì slot cuối chạy phần dư (cách duy nhất để bảo toàn W chính xác).
    """
    zero = np.zeros(N_SLOTS, dtype=np.int16)
    if W_units <= 0 or n_units <= 0:
        return [zero]
    A0, A1 = ALLOWABLE_MIN, ALLOWABLE_MAX
    span = A1 - A0 + 1
    if UNIT_COMMITMENT:
        m_min = _unit_bounds(n_units)
        L_lo = max(MIN_WINDOW_SLOTS, int(np.ceil(W_units / n_units)))
        L_hi = min(MAX_PUMP_SLOTS_DAY, span, W_units // m_min)
        plan = [(L, _block_levels(W_units, L)) for L in range(L_lo, L_hi + 1)]
    else:
        L = int(np.ceil(W_units / n_units))
        lvl = np.full(L, n_units, dtype=np.int16)
        rem = W_units - (L - 1) * n_units
        lvl[-1] = rem
        plan = [(L, lvl)] if MIN_WINDOW_SLOTS <= L <= span else []

    out = []
    for L, lvl in plan:
        if L <= MAX_WINDOW_SLOTS:                               # một ca
            for s0 in range(A0, A1 - L + 2):
                x = zero.copy(); x[s0:s0 + L] = lvl
                out.append(x)
        if MAX_BLOCKS >= 2 and L >= 2 * MIN_WINDOW_SLOTS and L + GAP_SLOTS <= span:  # hai ca
            for n1 in range(MIN_WINDOW_SLOTS, min(MAX_WINDOW_SLOTS, L - MIN_WINDOW_SLOTS) + 1):
                n2 = L - n1
                if n2 > MAX_WINDOW_SLOTS:
                    continue
                for t1 in range(A0, A1 - L - GAP_SLOTS + 2):
                    for t2 in range(t1 + n1 + GAP_SLOTS, A1 - n2 + 2):
                        x = zero.copy()
                        x[t1:t1 + n1] = lvl[:n1]; x[t2:t2 + n2] = lvl[n1:]
                        out.append(x)

    if not out:
        # Không lịch nào thoả đủ (R3)-(R5): ví dụ lượng nước quá nhỏ (W < MIN_WINDOW·m_min) hoặc
        # quá lớn. Nới DUY NHẤT phần cần thiết cho riêng trạm này và GHI LẠI để báo cáo.
        L_lo = max(1, int(np.ceil(W_units / n_units)))
        for L in range(L_lo, min(span, W_units) + 1):
            lvl = _block_levels(W_units, L)
            if lvl.max() > n_units or lvl.min() < 1:
                continue
            for s0 in range(A0, A1 - L + 2):
                x = zero.copy(); x[s0:s0 + L] = lvl
                out.append(x)
        if code is not None and UNIT_COMMITMENT:
            _RELAXED[code] = (f"W = {W_units} tổ-slot, n = {n_units}: không có lịch thoả đồng thời "
                              f"ca >= {MIN_WINDOW_SLOTS} slot, >= {_unit_bounds(n_units)} tổ/slot và "
                              f"<= {MAX_PUMP_SLOTS_DAY} slot/ngày -> nới cho riêng trạm này")
    if not out:
        out = [zero]
    return out


def _runs(x):
    """Các đoạn liên tục x>0: danh sách (bắt đầu, độ dài)."""
    on = (np.asarray(x) > 0).astype(int)
    d = np.diff(np.concatenate([[0], on, [0]]))
    starts, ends = np.where(d == 1)[0], np.where(d == -1)[0]
    return [(int(s), int(e - s)) for s, e in zip(starts, ends)]


def validate_schedule(x, st, check_rules=True):
    """[v9 F3] Kiểm lại MỌI ràng buộc bơm tưới (R1)-(R5) trên một lịch. Trả về danh sách vi phạm."""
    x = np.asarray(x)
    errs = []
    n, W = int(st["n_units"]), int(st["W_units"])
    if np.any(x < 0) or np.any(x > n):
        errs.append(f"R1: số tổ ngoài [0, {n}]")
    outside = np.ones(N_SLOTS, bool); outside[ALLOWABLE_MIN:ALLOWABLE_MAX + 1] = False
    if np.any(x[outside] > 0):
        errs.append("R1: bơm ngoài khung Ω")
    if int(np.sum(x)) != W:
        errs.append(f"R2: Σx = {int(np.sum(x))} ≠ W = {W}")
    if not check_rules or st.get("code") in _RELAXED or W == 0:
        return errs
    runs = _runs(x)
    if len(runs) > MAX_BLOCKS:
        errs.append(f"R3: {len(runs)} ca > {MAX_BLOCKS}")
    for s, L in runs:
        if not (MIN_WINDOW_SLOTS <= L <= MAX_WINDOW_SLOTS):
            errs.append(f"R3: ca bắt đầu {hhmm(s)} dài {L * DT_H:.1f} h ngoài "
                        f"[{MIN_WINDOW_SLOTS * DT_H:.0f}, {MAX_WINDOW_SLOTS * DT_H:.0f}] h")
    for (s1, L1), (s2, _) in zip(runs[:-1], runs[1:]):
        if s2 - (s1 + L1) < GAP_SLOTS:
            errs.append(f"R3: nghỉ giữa ca {(s2 - s1 - L1) * DT_H:.1f} h < {GAP_SLOTS * DT_H:.1f} h")
    if UNIT_COMMITMENT:
        m_min = _unit_bounds(n)
        nz = x[x > 0]
        if nz.size and int(nz.min()) < m_min:
            errs.append(f"R4: có slot chạy {int(nz.min())} tổ < {m_min} tổ tối thiểu")
    if int(np.sum(x > 0)) > MAX_PUMP_SLOTS_DAY:
        errs.append(f"R5: bơm {np.sum(x > 0) * DT_H:.1f} h/ngày > {MAX_PUMP_SLOTS_DAY * DT_H:.0f} h")
    return errs


def assert_schedule_valid(sched, stations, tag, check_rules=True):
    """Assertion cứng: lịch tối ưu PHẢI thoả (R1)-(R5) ở mọi trạm."""
    bad = {c: validate_schedule(sched[c], st, check_rules)
           for c, st in stations.items() if st["P_pump"] > 0}
    bad = {c: e for c, e in bad.items() if e}
    if bad:
        msg = "; ".join(f"{c}: {', '.join(e)}" for c, e in list(bad.items())[:5])
        raise AssertionError(f"LỊCH {tag} VI PHẠM RÀNG BUỘC BƠM TƯỚI: {msg}")
    return True


_POOL_CACHE = {}


def _thermal_ok(st, cand_arr, pv_roof=None):
    """Lọc nhiệt (R6) có tính PV áp mái không phát ngược: cand_arr shape (k, 48)."""
    p = st["P_base"][None, :] + cand_arr * st["p_unit"]
    q = st["Q_base"][None, :] + cand_arr * st["q_unit"]
    if pv_roof is not None:
        p = p - np.minimum(np.asarray(pv_roof, float)[None, :], np.maximum(p, 0.0))
    s = np.hypot(p, q)
    over = np.maximum(0.0, s - TR_LIMIT * st["TRs"])
    return over.max(axis=1) <= 1e-9, over.sum(axis=1)


def build_candidate_pools(stations, verbose=True, tag="", pv_roof=None):
    """
    [L3] Lấy mẫu pool bằng POOL_SEED CỐ ĐỊNH -> so sánh các cấu hình thuật toán là GHÉP CẶP.
    [L8] Báo cáo |X_i| trước và sau lọc/cắt.  [v9] Lọc nhiệt có tính PV áp mái (pv_roof).
    tag PHẢI khác nhau cho các cấu hình pv_roof khác nhau (khoá bộ nhớ đệm).
    """
    key = (tag, UNIT_COMMITMENT, MAX_CANDIDATES, POOL_SEED)
    if key in _POOL_CACHE:
        return _POOL_CACHE[key]
    rng = np.random.default_rng(POOL_SEED)
    active = [c for c, st in stations.items() if st["P_pump"] > 0 and st["W_units"] > 0]
    pools, infeasible, raw_sizes, safe_sizes = {}, [], {}, {}
    pv_roof = pv_roof or {}
    for c in active:
        st = stations[c]
        raw = generate_candidates(st["W_units"], st["n_units"], code=c)
        raw_sizes[c] = len(raw)
        arr = np.array(raw, dtype=np.int16)
        ok, viol = _thermal_ok(st, arr, pv_roof.get(c))
        safe = [raw[i] for i in np.where(ok)[0]]
        safe_sizes[c] = len(safe)
        if safe:
            pool = safe
        else:
            infeasible.append(c)
            pool = [raw[i] for i in np.argsort(viol)[:max(1, len(raw) // 10)]]
        if len(pool) > MAX_CANDIDATES:
            pool = [pool[i] for i in rng.choice(len(pool), MAX_CANDIDATES, replace=False)]
        pools[c] = pool
    if verbose:
        print(f" [+] |X_i| TRƯỚC lọc/cắt : min={min(raw_sizes.values()):,}, "
              f"max={max(raw_sizes.values()):,}, tổng={sum(raw_sizes.values()):,}")
        print(f" [+] |X_i| SAU lọc nhiệt : min={min(safe_sizes.values()):,}, "
              f"max={max(safe_sizes.values()):,}, tổng={sum(safe_sizes.values()):,}")
        n_cap = sum(1 for c in active if safe_sizes[c] > MAX_CANDIDATES)
        print(f" [+] |X_i| SAU cắt mẫu   : {sum(len(v) for v in pools.values()):,} "
              f"({n_cap}/{len(active)} trạm chạm trần {MAX_CANDIDATES}, seed pool = {POOL_SEED})")
        if infeasible:
            print(f" [!] Trạm KHÔNG tồn tại lịch thoả ràng buộc nhiệt (R6): {infeasible}")
        else:
            print(" [+] Mọi trạm đều có lịch thoả ràng buộc nhiệt (R6).")
        rel = [c for c in active if c in _RELAXED]
        if rel:
            print(f" [!] Trạm phải NỚI ràng buộc khi sinh ứng viên: {rel}")
            for c in rel:
                print(f"     {c}: {_RELAXED[c]}")
    res = (active, pools, infeasible, raw_sizes, safe_sizes)
    _POOL_CACHE[key] = res
    return res


def check_water_conservation(schedule, stations, tag=""):
    for c, st in stations.items():
        got = int(np.sum(schedule[c]))
        assert got == st["W_units"], f"VI PHẠM BẢO TOÀN NƯỚC {tag} tại {c}: {got} != {st['W_units']}"
    return True


def starts_of(x):
    b = (np.asarray(x) > 0).astype(np.int16)
    return np.maximum(0, b - np.roll(b, 1))


def start_kva_of(x, s_unit):
    """[L5] kVA khởi động: chênh lệch DƯƠNG của công suất đóng vào giữa 2 slot liên tiếp."""
    x = np.asarray(x, float)
    return np.maximum(0.0, x - np.roll(x, 1)) * s_unit * MOTOR_INRUSH_RATIO


def start_metric(schedule, stations, codes):
    if K_START_MODE == "kva":
        return np.sum([start_kva_of(schedule[c], stations[c]["s_unit"]) for c in codes], axis=0)
    return np.sum([starts_of(schedule[c]) for c in codes], axis=0)


def calibrate_kstart(stations):
    """Hiệu chuẩn giới hạn khởi động từ CHÍNH hiện trạng đo xa (lưới đang chịu được mức này)."""
    global K_START_KVA_MAX
    codes = list(stations.keys())
    s2 = {c: stations[c]["x_S2"] for c in codes}
    v_kva = np.sum([start_kva_of(s2[c], stations[c]["s_unit"]) for c in codes], axis=0)
    v_cnt = np.sum([starts_of(s2[c]) for c in codes], axis=0)
    if K_START_KVA_MAX is None:
        K_START_KVA_MAX = float(K_START_CALIB * np.max(v_kva))
    print(f" [+] Hiệu chuẩn ràng buộc khởi động từ hiện trạng S2:")
    print(f"     max kVA khởi động/slot (S2) = {np.max(v_kva):,.0f} kVA lúc "
          f"{hhmm(int(np.argmax(v_kva)))}  -> đặt K_start_kVA = {K_START_KVA_MAX:,.0f} kVA")
    nmax = int(np.max(v_cnt))
    if nmax > K_START_MAX:
        print(f"     max SỐ TRẠM khởi động/slot (S2) = {nmax} > K_start = {K_START_MAX} của bản")
        print(f"     thảo -> CHÍNH HIỆN TRẠNG đã vi phạm giá trị đó, nên K_start = {K_START_MAX}")
        print(f"     không thể dùng nếu không có biện minh kỹ thuật riêng (sụt áp, bảo vệ).")
    else:
        print(f"     max SỐ TRẠM khởi động/slot (S2) = {nmax} (<= {K_START_MAX}). Giá trị "
              f"K_start = {K_START_MAX}")
        print(f"     của bản thảo vẫn cần BIỆN MINH: nó không suy ra được từ dữ liệu, trong khi")
        print(f"     ràng buộc theo kVA khởi động thì hiệu chuẩn trực tiếp từ vận hành thực tế.")
    return K_START_KVA_MAX


def kstart_limit():
    return K_START_KVA_MAX if K_START_MODE == "kva" else float(K_START_MAX)


