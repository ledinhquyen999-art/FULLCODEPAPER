def profile_metrics(p):
    p = np.asarray(p, float)
    pmax, pmin, pavg = float(np.max(p)), float(np.min(p)), float(np.mean(p))
    return {"Pmax (kW)": round(pmax, 1), "Pmin (kW)": round(pmin, 1),
            "Pavg (kW)": round(pavg, 1), "LF": round(pavg / pmax, 3) if pmax > 0 else 0.0,
            "Std (kW)": round(float(np.std(p)), 1),
            "Peak-valley (kW)": round(pmax - pmin, 1),
            "Reverse (kW)": round(min(0.0, pmin), 1),
            "E_ngay (kWh)": round(float(np.sum(p) * DT_H), 0)}


