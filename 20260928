def _plant_kwp():
    if PV_CENTRAL_KWP_PLANT:
        return {cc: float(PV_CENTRAL_KWP_PLANT.get(cc, 0.0)) for cc in CENTRAL_PV_CODES}
    each = PV_CENTRAL_KWP / max(len(CENTRAL_PV_CODES), 1)
    return {cc: each for cc in CENTRAL_PV_CODES}


def _plant_share(cc):
    k = _plant_kwp()
    tot = sum(k.values())
    return k.get(cc, 0.0) / tot if tot > 0 else 1.0 / max(len(CENTRAL_PV_CODES), 1)


def _pv_series_plausible(p, kwp):
    """Chuỗi công suất một nhà máy ĐMT có hợp lý vật lý không."""
    p = np.asarray(p, float)
    if p.size != N_SLOTS or not np.isfinite(p).all():
        return False, "không đủ 48 giá trị hữu hạn"
    pk = float(np.max(p))
    if pk < 0.15 * kwp:
        return False, f"đỉnh {pk:,.0f} kW < 15% công suất lắp {kwp:,.0f} kWp"
    if pk > 1.15 * kwp:
        return False, f"đỉnh {pk:,.0f} kW > 115% công suất lắp {kwp:,.0f} kWp"
    night = np.r_[0:10, 40:48]
    if float(np.mean(p[night])) > 0.03 * pk:
        return False, "có công suất đáng kể ban đêm -> không phải chuỗi phát ĐMT"
    h = float(np.argmax(p)) * DT_H
    if not (8.0 <= h <= 16.0):
        return False, f"đỉnh lúc {hhmm(int(np.argmax(p)))} - bất thường"
    return True, ""


def _strip_acc(t):
    import unicodedata
    t = unicodedata.normalize("NFD", str(t))
    return "".join(ch for ch in t if unicodedata.category(ch) != "Mn").replace("đ", "d").replace("Đ", "D").lower()


def _is_other_season(path):
    """Đường dẫn nằm trong thư mục ngày/mùa KHÁC (mùa mưa, rain...)."""
    p = _strip_acc(path)
    return any(k in p for k in ("mua mua", "muamua", "rain", "wet"))


def _find_anywhere(code):
    """[v9.3] Tìm file đo xa theo mã trong thư mục INPUT (kể cả con) và pv_output, BỎ QUA thư mục
    của mùa/ngày khác (mùa mưa) - số đo khác ngày không được dùng làm 'số đo cùng ngày'."""
    for d in (INPUT_DIR, PV_DIR):
        if not os.path.isdir(d):
            continue
        hits = sorted(glob.glob(os.path.join(d, "**", f"*{code}*.xlsx"), recursive=True))
        hits = [h for h in hits if not os.path.basename(h).startswith("~$") and not _is_other_season(h)]
        if hits:
            return hits[0]
    return None


def _file_date(path):
    """Ngày đo (cột Date) của một file đo xa; None nếu không đọc được."""
    try:
        df = pd.read_excel(path)
        col = next((c for c in df.columns if str(c).strip().lower() in ("date", "ngay", "ngày")), None)
        if col is None:
            return None
        v = pd.to_datetime(df[col], errors="coerce").dropna()
        return v.iloc[0].date() if len(v) else None
    except Exception:
        return None


