    pv_cen, pv_plants, pv_src, df_pvval, pv_measured = load_central_pv(dry, pv_model)
    # [v9.3] Ngưỡng tiếp nhận là bài toán TRƯỜNG HỢP XẤU NHẤT cho phát ngược -> luôn dùng đường phát
    # TRỜI QUANG (mô hình PVGIS "best"), không dùng số đo của một ngày cụ thể (có thể có mây).
    pv_unit = pv_model * PV_UNIT_FILE_KWP / PV_CENTRAL_KWP
    day = np.where(pv_cen > 0.01 * max(float(np.max(pv_cen)), 1e-9))[0]
    if pv_measured:
        roof_unit = pv_cen / PV_CENTRAL_KWP * (ROOF_PV_DERATE / PV_SYSTEM_DERATE)
        roof_src = "tỉ lệ theo SỐ ĐO ĐMT trung thế cùng ngày (cùng thời tiết)"
    else:
        roof_unit = pv_central_power(g_best, amb, 1.0, derate=ROOF_PV_DERATE)
        roof_src = "mô hình NOCT từ G(t), T(t)"
    print(f" [+] PV áp mái: đường 1 kWp {roof_src}; đỉnh {np.max(roof_unit):.3f} kW/kWp, "
          f"{np.sum(roof_unit) * DT_H:.2f} kWh/kWp/ngày.")
    g_cloud = None
    for kk in PV_CLOUDY_KEYS:
        g_cloud = read_pv_irradiance(kk)
        if g_cloud is not None:
            break
    zeros = np.zeros(N_SLOTS)
    sched_S1 = {c: np.zeros(N_SLOTS, dtype=np.int16) for c in stations}
    sched_S2 = {c: np.asarray(stations[c]["x_S2"], dtype=np.int16) for c in stations}

    # ---- [3] Đối chứng mô hình nhị phân của [1] -------------------------------------------------
    banner("[3] ĐỐI CHỨNG: MÔ HÌNH NHỊ PHÂN (cách biểu diễn của [1]) vs MÔ HÌNH SỐ TỔ")
    UNIT_COMMITMENT = False
    _POOL_CACHE.clear()
    _a, _p, infeas_bin, _rs, _ss = build_candidate_pools(stations, verbose=False, tag="bin")
    sched_bin, _, _, _ = run_optimizer(stations, others, pv_cen, verbose=False, pool_tag="bin",
                                       label="nhị phân")
    UNIT_COMMITMENT = True
    _POOL_CACHE.clear()
    net_bin = {c: station_net(stations[c], sched_bin[c]) for c in stations}
    over_bin = [c for c in stations if net_bin[c]["peak"] > TR_LIMIT * stations[c]["TRs"] + 1e-6]
    print(f" [+] Mô hình NHỊ PHÂN: {len(infeas_bin)} trạm KHÔNG có lịch thoả (R6) {infeas_bin}; "
          f"sau tối ưu còn {len(over_bin)} trạm quá tải {over_bin}")
    print(f"     [1] kết luận nâng cấp: {list(REF_PAPER['upgrades'])}")
    print("     -> Với mô hình SỐ TỔ (mục [4]) các trạm này đều có lịch khả thi: nhu cầu nâng cấp")
    print("        là hệ quả của cách biểu diễn nhị phân, không phải của lưới.")

    # ---- [4] Ngưỡng đỉnh phụ tải thật (R8) -----------------------------------------------------
    p_ind = np.sum([o["P"] for o in others["loads"].values()], axis=0)
    lp_s2 = float(np.max(p_ind + np.sum([station_net(st, st["x_S2"])["p_load"]
                                         for st in stations.values()], axis=0)))
    lpg = (LOAD_PEAK_MARGIN * lp_s2 / 1000.0) if GUARD_LOAD_PEAK else None
    banner("[4] LẬP LỊCH: S3 (có xét ĐMT) và S0opt/S3blind (không xét ĐMT, cách của [1])")
    print(f" [R8] Đỉnh PHỤ TẢI THẬT (trước mọi PV) không vượt hiện trạng: {lp_s2:,.0f} kW")
    sched_S3, J_S3, ev3, inf3 = run_optimizer(stations, others, pv_cen, load_peak_guard=lpg,
                                              label="S3 (có xét ĐMT)")
    print(f" [+] S3: J = {J_S3:.4f} | vi phạm nhiệt = {ev3.full(sched_S3)['thermal_pen']:.3f} kVA-slot")
    sched_blind, J_bl, _, _ = run_optimizer(stations, others, zeros, load_peak_guard=lpg,
                                            label="S0opt/S3blind (KHÔNG xét ĐMT)")
    print(f" [+] Lịch không xét ĐMT: J(trên lưới không ĐMT) = {J_bl:.4f}")

    # ---- [4b] Pareto + S3A -----------------------------------------------------------------------
    df_par, par_store, w_knee = ageing_pareto(stations, others, pv_cen, lpg)
    peak_S3 = float(np.max(feeder_profile(stations, others, sched_S3, pv_cen)[0]))
    sA_full, _, _, _ = run_optimizer(stations, others, pv_cen, w_ageing=w_knee,
                                     load_peak_guard=lpg, verbose=False, label="S3A")
    evA = Evaluator(stations, others, pv_cen, w_ageing=w_knee, load_peak_guard=lpg)
    print(f"\n [+] Chọn lời giải S3A tại w* = {w_knee:g}, trần đỉnh = đỉnh S3 {peak_S3:,.0f} kW "
          f"x (1 + {KNEE_PEAK_COST_CAP:.0%}):")
    sched_S3A = pick_ageing_solution([("Pareto (tìm kiếm rút gọn)", par_store[w_knee]),
                                      ("giải lại đầy đủ", sA_full), ("S3", sched_S3)],
                                     evA, stations, others, pv_cen, peak_S3,
                                     fallback=sched_S3, tag="S3A")

    # ---- [5] PV áp mái + lập lịch đồng thời -----------------------------------------------------
    R = {}
    R["S3"] = evaluate(stations, others, sched_S3, pv_cen)
    m_s3 = scenario_metrics(stations, R["S3"], day)
    df_roof, eta_s, kwp_s, roof_s, roof_th_s = (None, None, {}, None, None)
    sched_S4 = sched_S4A = None
    if ROOF_THERMAL_BASIS == "design":
        roof_unit_th = roof_unit
    elif ROOF_THERMAL_BASIS == "worst" and g_cloud is not None:
        roof_unit_th = pv_central_power(g_cloud, amb, 1.0, derate=ROOF_PV_DERATE)
    else:
        roof_unit_th = np.zeros(N_SLOTS)
    if ROOF_PV_ENABLE:
        df_roof, eta_s, kwp_s, roof_s, roof_th_s = rooftop_sweep(
            stations, others, pv_cen, roof_unit, lpg, day, m_s3, R["S3"],
            roof_per_kwp_thermal=roof_unit_th)
        tag_s = f"roof{eta_s:.4f}_{ROOF_THERMAL_BASIS}"
        sched_S4, _, _, inf4 = run_optimizer(stations, others, pv_cen, pv_roof=roof_s,
                                             load_peak_guard=lpg, pool_tag=tag_s, verbose=False,
                                             label="S4", pv_roof_thermal=roof_th_s)
        s4a_1, _, _, _ = run_optimizer(stations, others, pv_cen, pv_roof=roof_s, w_ageing=w_knee,
                                       load_peak_guard=lpg, pool_tag=tag_s, verbose=False,
                                       label="S4A", pv_roof_thermal=roof_th_s)
        ev4A = Evaluator(stations, others, pv_cen, pv_roof=roof_s, w_ageing=w_knee,
                         load_peak_guard=lpg)
        peak_S4 = float(np.max(feeder_profile(stations, others, sched_S4, pv_cen, roof_s)[0]))
        print(f"\n [+] Chọn lời giải S4A tại w* = {w_knee:g}, trần đỉnh = đỉnh S4 {peak_S4:,.0f} kW "
              f"x (1 + {KNEE_PEAK_COST_CAP:.0%}):")
        sched_S4A = pick_ageing_solution([("giải đầy đủ", s4a_1), ("S4", sched_S4)], ev4A,
                                         stations, others, pv_cen, peak_S4, pv_roof=roof_s,
                                         fallback=sched_S4, tag="S4A")
        print(f" [+] S4/S4A giải xong ở η* = {eta_s:g} ({sum(kwp_s.values()):,.0f} kWp tại "
              f"{len(kwp_s)} trạm bơm), w* = {w_knee:g}")

    # ---- [6] KIỂM TRA RÀNG BUỘC BƠM TƯỚI CỦA MỌI LỊCH TỐI ƯU ----------------------------------
    banner("[6] KIỂM TRA RÀNG BUỘC BƠM TƯỚI (R1)-(R7) TRÊN MỌI LỊCH TỐI ƯU")
    opt_scheds = {"S0opt/S3blind": sched_blind, "S3": sched_S3, "S3A": sched_S3A}
    if sched_S4 is not None:
        opt_scheds.update({"S4": sched_S4, "S4A": sched_S4A})
    klim = kstart_limit()
    for k, sc in opt_scheds.items():
        check_water_conservation(sc, stations, k)
        assert_schedule_valid(sc, stations, k)
        v = start_metric(sc, stations, list(stations.keys()))
        ok7 = np.max(v) <= klim + 1e-6
        print(f" [+] {k:14s}: (R1)-(R5) ĐẠT | khởi động max {np.max(v):6,.0f} / {klim:,.0f} kVA "
              f"-> {'ĐẠT' if ok7 else 'VI PHẠM'}")
        if not ok7:
            raise AssertionError(f"Lịch {k} vi phạm ràng buộc khởi động (R7)")
    p_ind_ = np.sum([o["P"] for o in others["loads"].values()], axis=0)
    for k, sc in opt_scheds.items():
        lp = float(np.max(p_ind_ + np.sum([station_net(st, sc[c])["p_load"]
                                            for c, st in stations.items()], axis=0)))
        ok8 = lp <= lp_s2 * LOAD_PEAK_MARGIN + 1.0
        print(f" [{'+' if ok8 else '!'}] {k:14s}: (R8) đỉnh phụ tải thật {lp:8,.0f} / {lp_s2:,.0f} kW "
              f"-> {'ĐẠT' if ok8 else 'VI PHẠM - phải nêu trong bài hoặc tăng W_LOADPEAK_LIN'}")
    v2 = start_metric(sched_S2, stations, list(stations.keys()))
    print(f" [i] S2 (hiện trạng): khởi động max {np.max(v2):,.0f} kVA (mốc hiệu chuẩn S_start)")

    # ---- [7] KỊCH BẢN, CHỈ TIÊU 3 CẤP ----------------------------------------------------------
    banner("[7] BẢNG KỊCH BẢN - CHỈ TIÊU XUẤT TUYẾN / MÁY BIẾN ÁP / CÁCH ĐIỆN")
    R["S0"] = evaluate(stations, others, sched_S2, zeros)
    R["S0opt"] = evaluate(stations, others, sched_blind, zeros)
    R["S1"] = evaluate(stations, others, sched_S1, pv_cen)
    R["S2"] = evaluate(stations, others, sched_S2, pv_cen)
    R["S3blind"] = evaluate(stations, others, sched_blind, pv_cen)
    R["S3A"] = evaluate(stations, others, sched_S3A, pv_cen)
    if sched_S4 is not None:
        R["S4"] = evaluate(stations, others, sched_S4, pv_cen, roof_s, kwp_s)
        R["S4A"] = evaluate(stations, others, sched_S4A, pv_cen, roof_s, kwp_s)
    order = [k for k in ["S0", "S0opt", "S1", "S2", "S3blind", "S3", "S3A", "S4", "S4A"] if k in R]
    M = {k: scenario_metrics(stations, R[k], day) for k in order}
    df_sum = pd.DataFrame([{"Kịch bản": k, **M[k]} for k in order])
    cols_show = ["Kịch bản", "Pmax (kW)", "Pmin (kW)", "Pavg (kW)", "LF", "Std (kW)",
                 "P_min ban ngày (kW)", "Pmax tải thật (kW)", "Số trạm bơm ở giờ đỉnh"]
    print(" (a) CẤP XUẤT TUYẾN (P tại nút nguồn, đã trừ mọi PV)")
    print(df_sum[cols_show].to_string(index=False))
    print("\n (b) CẤP MÁY BIẾN ÁP VÀ CÁCH ĐIỆN")
    print(df_sum[["Kịch bản", "K_max mọi MBA", "K_max trạm bơm", "Số MBA >105%", "Số MBA >100%",
                  "Giờ-trạm K>0,8", "ΣL (h/ngày)", "θ_h max (°C)",
                  "Số MBA lão hoá > chuẩn"]].to_string(index=False))
    print("\n (c) THỜI ĐIỂM BƠM VÀ PV ÁP MÁI")
    print(df_sum[["Kịch bản", "E bơm (kWh)", "Tỉ lệ E bơm giờ nắng (%)", "θ_a TB theo E bơm (°C)",
                  "θ_a hiệu dụng K² (°C)", "PV áp mái (kWp)", "PV áp mái tự dùng (kWh)",
                  "PV áp mái bị cắt (kWh)"]].to_string(index=False))
    print("\n [!] L_F chỉ so sánh được giữa các kịch bản CÙNG điện năng ròng: {S2, S3blind, S3, S3A}"
          " và {S4, S4A}; S0/S0opt không có ĐMT, S1 không tưới.")

    # Bảo toàn: nước + điện năng PHỤ TẢI THẬT như nhau ở mọi kịch bản có tưới
    e_load = {k: M[k]["E tải thật (kWh)"] for k in order if k != "S1"}
    spread = max(e_load.values()) - min(e_load.values())
    assert spread < 1.0, f"VI PHẠM BẢO TOÀN ĐIỆN NĂNG PHỤ TẢI: chênh {spread:.3f} kWh"
    print(f"\n [+] BẢO TOÀN: cùng {sum(st['W_units'] for st in stations.values()):,} tổ-slot nước và "
          f"cùng điện năng phụ tải thật ({min(e_load.values()):,.1f} kWh) ở {len(e_load)} kịch bản "
          f"có tưới (chênh {spread:.3f} kWh).")

    print("\n MẠCH SO SÁNH MỘT-BIẾN (mỗi dòng chỉ đổi đúng thứ trong ngoặc):")
    steps = [("S0", "S0opt", "lập lịch không xét ĐMT - bài toán của [1], mô hình số tổ"),
             ("S0opt", "S3blind", "thêm 3 MWp ĐMT trung thế, GIỮ lịch"),
             ("S3blind", "S3", "lập lịch lại CÓ xét ĐMT"),
             ("S2", "S3", "đổi lịch hiện trạng -> lịch san bằng (cùng ĐMT)"),
             ("S3", "S3A", "thêm tiêu chí tổn thọ IEC"),
             ("S3", "S4", "thêm PV áp mái + tối ưu lại lịch"),
             ("S4", "S4A", "thêm tiêu chí tổn thọ IEC (có PV áp mái)")]
    print(f"   {'Bước':18s} {'Đỉnh ròng (kW)':>20s} {'K_max bơm':>16s} {'Giờ K>0,8':>16s} "
          f"{'ΣL (h/ngày)':>20s}")
    df_chain = []
    for a, b, what in steps:
        if a in M and b in M:
            print(f"   {a + ' -> ' + b:18s} {M[a]['Pmax (kW)']:8,.0f} ->{M[b]['Pmax (kW)']:8,.0f} "
                  f"{M[a]['K_max trạm bơm']:6.3f} ->{M[b]['K_max trạm bơm']:6.3f} "
                  f"{M[a]['Giờ-trạm K>0,8']:6.1f} ->{M[b]['Giờ-trạm K>0,8']:6.1f} "
                  f"{M[a]['ΣL (h/ngày)']:8.2f} ->{M[b]['ΣL (h/ngày)']:8.2f}  ({what})")
            df_chain.append({"Từ": a, "Đến": b, "Thay đổi": what,
                             "Đỉnh ròng từ (kW)": M[a]["Pmax (kW)"],
                             "Đỉnh ròng đến (kW)": M[b]["Pmax (kW)"],
                             "K_max bơm từ": M[a]["K_max trạm bơm"],
                             "K_max bơm đến": M[b]["K_max trạm bơm"],
                             "Giờ K>0,8 từ": M[a]["Giờ-trạm K>0,8"],
                             "Giờ K>0,8 đến": M[b]["Giờ-trạm K>0,8"],
                             "ΣL từ": M[a]["ΣL (h/ngày)"], "ΣL đến": M[b]["ΣL (h/ngày)"]})
    df_chain = pd.DataFrame(df_chain)

    df_claims = claims_check(stations, M, R)

    # ---- [8] IEC 60076-7 TỪNG MBA ------------------------------------------------------------------
    banner("[8] TỔN THỌ CÁCH ĐIỆN IEC 60076-7 - TỪNG MÁY BIẾN ÁP")
    print(f" Nhiệt độ môi trường: {_AMBIENT['source']}")
    th_keys = [k for k in ["S2", "S3", "S3A", "S4", "S4A"] if k in R]
    df_th = pd.concat([thermal_report_all(stations, R[k]["nets"], k) for k in th_keys],
                      ignore_index=True)
    agg = df_th.groupby("Kịch bản", sort=False).agg(
        **{"Σ tổn thọ (h/ngày)": ("Tổn thọ (h/ngày)", "sum"),
           "Max θ_hs (°C)": ("θ_hs_max (°C)", "max"),
           "Số MBA lão hoá nhanh": ("V_tb", lambda s: int((s > 1).sum())),
           "Σ giờ > 120°C": ("Giờ > 120°C", "sum")}).reset_index()
    print(agg.to_string(index=False))
    n_tf = len(stations)
    print(f" [i] Mốc lão hoá chuẩn của đội {n_tf} MBA = {24 * n_tf} h/ngày.")
    if (df_th[df_th["Kịch bản"] == "S2"]["V_tb"] <= 1.0).all():
        print(" [i] Ở hiện trạng KHÔNG MBA nào lão hoá nhanh hơn chuẩn: luận điểm của bài là CHIỀU")
        print("     của tiêu chí tối ưu, không phải nguy cơ thiết bị trước mắt.")

    df_decomp = ageing_decomposition(
        stations, {k: (net_bin if k == "S3bin" else R[k]["nets"])
                   for k in ["S2", "S3bin", "S3", "S3A", "S4", "S4A"] if k == "S3bin" or k in R},
        profiles={"S2": R["S2"]["P_sys"], "S3": R["S3"]["P_sys"],
                  "S3bin": feeder_profile(stations, others, sched_bin, pv_cen)[0]})
    df_sens = iec_sensitivity(stations, {k: R[k]["nets"] for k in th_keys})
    df_growth = load_growth_study(stations, others, pv_cen, w_knee, day)
    df_method = (method_sensitivity(spec, dry, pv_cen, w_knee, day, M, R)
                 if RUN_METHOD_SENSITIVITY else None)

    # ---- [8b] Đối chiếu với [1] --------------------------------------------------------------------
    banner("[8b] ĐỐI CHIẾU VỚI BẢNG 1 CỦA [1] (bối cảnh không ĐMT: phụ tải thật)")
    cmp_rows = []
    for mine, ref in (("S1", "S1"), ("S0", "S2"), ("S0opt", "S3")):
        rr = REF_PAPER["table1"][ref]
        mm = profile_metrics(R[mine]["P_load"])
        cmp_rows.append({"[1]": ref, "Bài này": mine, "[1] Pmax": rr["Pmax"],
                         "Pmax": mm["Pmax (kW)"], "[1] Pavg": rr["Pavg"], "Pavg": mm["Pavg (kW)"],
                         "[1] Pmin": rr["Pmin"], "Pmin": mm["Pmin (kW)"], "[1] LF": rr["LF"],
                         "LF": mm["LF"]})
    df_cmp = pd.DataFrame(cmp_rows)
    print(df_cmp.to_string(index=False))
    print(" [i] Khác biệt với [1] đến từ: ngày dữ liệu, phương pháp bóc tách, cách biểu diễn cụm")
    print("     bơm, và S1 của [1] là ngày mùa mưa (ở đây S1 là tải nền bóc tách cùng ngày).")
    print(f"     Ở đây P_avg của S0 và S0opt bằng nhau ({profile_metrics(R['S0']['P_load'])['Pavg (kW)']:,.1f}"
          f" và {profile_metrics(R['S0opt']['P_load'])['Pavg (kW)']:,.1f} kW) do bảo toàn nước chặt.")

    # ---- [8c] Độ bền ---------------------------------------------------------------------------
    conds = {"ĐMT trung thế ngừng (trời vẫn nắng)": (zeros, roof_unit)}
    if g_cloud is not None:
        conds["Mây mù toàn vùng (PVGIS)"] = (pv_central_power(g_cloud, amb, PV_CENTRAL_KWP),
                                            pv_central_power(g_cloud, amb, 1.0,
                                                             derate=ROOF_PV_DERATE))
    else:
        print("\n [i] Không có file PVGIS ngày mây mù (tên chứa " + "/".join(PV_CLOUDY_KEYS)
              + ") -> chỉ kiểm tra trường hợp ĐMT trung thế ngừng.")
    df_rob = robustness_check(stations, others, R, conds, day)

    # ---- [9] Ngưỡng tiếp nhận --------------------------------------------------------------------
    banner("[9] NGƯỠNG TIẾP NHẬN ĐMT TRUNG THẾ (con số CÔNG BỐ = dòng tải tối thiểu)")
    hc = []
    hc_cases = [("S1 - tải tối thiểu (không tưới)", sched_S1, None, "S1: minimum load, no irrigation"),
                ("S3blind - lịch không xét ĐMT", sched_blind, None, "S3blind: PV-blind schedule"),
                ("S3 - lịch có xét ĐMT", sched_S3, None, "S3: PV-aware schedule")]
    if sched_S4 is not None:
        hc_cases.append(("S4 - lịch + PV áp mái", sched_S4, roof_s, "S4: schedule + rooftop PV"))
    for lbl, sc, rf, lbl_en in hc_cases:
        star, dfh = hosting_capacity_scan(stations, others, sc, pv_unit, lbl, pv_roof=rf)
