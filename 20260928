ETAP_COLS = ["P(MW)", "Q(Mvar)", "PF%", "V(p.u.)", "Angle", "Humidity", "Temp C",
             "Wind(m/s)", "Irradiance(W/m^2)", "Hour", "Min", "Seconds", "Date"]
_TEMPLATE = {"path": None}
_ETAP_WRITTEN = set()   # [V6.5] mọi tệp ETAP do lần chạy này ghi ra


def set_etap_template(dry_dir):
    for h in sorted(glob.glob(os.path.join(dry_dir, "*.xlsx"))):
        try:
            wb = openpyxl.load_workbook(h)
            ws = wb[wb.sheetnames[0]]
            if ws.max_row >= N_SLOTS + 1 and ws.max_column >= 13:
                _TEMPLATE["path"] = h
                return h
        except Exception:
            continue
    return None


def write_etap_file(p_kw, q_kvar, out_path, irradiance=None):
    """
    [V6.4] Ghi tệp mẫu tải ĐÚNG 13 CỘT cho ETAP.

    v6.3 sao chép một file đo xa đầu vào làm mẫu rồi ghi đè hai cột công suất. Cách đó kế thừa
    nguyên xi cấu trúc của file nguồn, mà file đo xa của đơn vị có 16 cột: ba cột cuối là
    "Sđm (MVA)", "Pđm (MW)" và "Tỷ lệ mang tải %", trong đó cột cuối chứa CÔNG THỨC Excel.
    Hệ quả: ETAP đọc theo vị trí cột nên gặp ba cột lạ, và openpyxl ghi công thức mà không kèm
    giá trị đã tính nên ETAP báo "File was opened or has no data in this file".

    Bản này luôn dựng tệp mới, đúng 13 cột, mọi ô đều là GIÁ TRỊ SỐ, không có công thức:
      1 P(MW)  2 Q(Mvar)  3 PF%  4 V(p.u.)  5 Angle  6 Humidity  7 Temp C
      8 Wind(m/s)  9 Irradiance(W/m^2)  10 Hour  11 Min  12 Seconds  13 Date
    Cột V(p.u.) để trống đúng như tệp mẫu vận hành của đơn vị, vì đó là đại lượng ETAP tự tính.
    """
    p = np.asarray(p_kw, float) / 1000.0
    q = np.asarray(q_kvar, float) / 1000.0
    amb = ambient_profile()
    irr = (np.asarray(irradiance, float) if irradiance is not None
           else np.zeros(N_SLOTS, float))
    d = datetime.datetime.strptime(ETAP_DATE, "%Y-%m-%d")

    wb = openpyxl.Workbook()
    ws = wb.active
    ws.append(ETAP_COLS)
    for i in range(N_SLOTS):
        s_i = float(np.hypot(p[i], q[i]))
        pf = (abs(p[i]) / s_i * 100.0) if s_i > 1e-12 else 100.0
        pf = float(min(100.0, max(0.0, pf)))
        ang = float(np.degrees(np.arccos(min(1.0, max(0.0, pf / 100.0)))))
        ws.append([round(float(p[i]), 6), round(float(q[i]), 6), round(pf, 2), None,
                   round(ang, 2), round(float(HUMIDITY_PCT), 1), round(float(amb[i]), 1),
                   round(float(WIND_MS), 1), round(float(irr[i]), 1),
                   i // 2, (i % 2) * 30, 0, d])
    for r in range(2, N_SLOTS + 2):                 # định dạng ngày như tệp mẫu
        ws.cell(r, 13).number_format = "yyyy-mm-dd"
    wb.save(out_path)
    _ETAP_WRITTEN.add(os.path.abspath(out_path))


def verify_etap_file(path):
    """[V6.4] Kiểm tra tệp vừa ghi có đúng 13 cột, 49 dòng, không ô công thức, không ô rỗng
    ngoài cột V(p.u.). Trả về danh sách lỗi (rỗng nếu đạt)."""
    errs = []
    wb = openpyxl.load_workbook(path)
    ws = wb[wb.sheetnames[0]]
    if ws.max_column != 13:
        errs.append(f"{ws.max_column} cột (phải 13)")
    if ws.max_row != N_SLOTS + 1:
        errs.append(f"{ws.max_row} dòng (phải {N_SLOTS + 1})")
    hdr = [ws.cell(1, c).value for c in range(1, min(14, ws.max_column + 1))]
    if hdr != ETAP_COLS[:len(hdr)]:
        errs.append("tiêu đề cột không khớp")
    for r in range(2, ws.max_row + 1):
        for c in range(1, min(14, ws.max_column + 1)):
            v = ws.cell(r, c).value
            if isinstance(v, str) and v.startswith("="):
                errs.append(f"ô {r},{c} chứa công thức")
                break
            if v is None and c != 4:
                errs.append(f"ô {r},{c} rỗng")
                break
        if errs:
            break
    return errs


def export_etap(stations, others, scen_defs):
    """
    Mỗi kịch bản một thư mục ETAP_<tên>:
      <mã TBA>.xlsx     : phụ tải GỘP của trạm (tải nền + bơm), CHƯA trừ PV áp mái
      PV_<mã TBA>.xlsx  : PV áp mái TỰ DÙNG (zero-export) - chỉ có ở kịch bản có PV áp mái
      <mã ĐMT>.xlsx     : công suất từng nhà máy ĐMT trung thế (số đo thật nếu có, không thì chia
                          tổng theo tỉ lệ kWp)
      <mã tải nhánh>.xlsx
    """
    banner("[ETAP] XUẤT TỆP MẪU TẢI 13 CỘT")
    _ETAP_WRITTEN.clear()
    _stale = 0
    if os.path.isdir(OUT_PATTERN_DIR):
        for _f in glob.glob(os.path.join(OUT_PATTERN_DIR, "**", "*.xlsx"), recursive=True):
            try:
                os.remove(_f); _stale += 1
            except Exception:
                pass
    if _stale:
        print(f" [i] Đã xoá {_stale} tệp .xlsx của lần chạy trước trong thư mục kịch bản.")
    os.makedirs(OUT_PATTERN_DIR, exist_ok=True)
    for name, d in scen_defs.items():
        sub = os.path.join(OUT_PATTERN_DIR, f"ETAP_{name}")
        os.makedirs(sub, exist_ok=True)
        n_pv = 0
        roof = d.get("pv_roof") or {}
        for c, st in stations.items():
            n = station_net(st, d["sched"][c], roof.get(c))
            write_etap_file(n["p_load"], n["q_load"], os.path.join(sub, f"{c}.xlsx"))
            if c in roof and float(np.max(n["pv_used"])) > 0:
                write_etap_file(n["pv_used"], np.zeros(N_SLOTS),
                                os.path.join(sub, f"PV_{c}.xlsx"), irradiance=d["gi"])
                n_pv += 1
        plants = d.get("pv_cen_plants")
        tot = np.asarray(d["pv_cen"], float)
        for cc in CENTRAL_PV_CODES:
            if plants is not None and cc in plants:
                p_cc = np.asarray(plants[cc], float)
            else:
                p_cc = tot * _plant_share(cc)
            write_etap_file(p_cc, np.zeros(N_SLOTS), os.path.join(sub, f"{cc}.xlsx"),
                            irradiance=d["gi"])
        for rc in RADIAL_CODES:
            g = others["loads"].get(rc)
            write_etap_file(g["P"] if g else np.zeros(N_SLOTS),
                            g["Q"] if g else np.zeros(N_SLOTS), os.path.join(sub, f"{rc}.xlsx"))
        print(f" [+] ETAP_{name:8s}: {len(stations)} TBA + {n_pv} PV áp mái + "
              f"{len(CENTRAL_PV_CODES)} ĐMT trung thế (đỉnh tổng {np.max(tot):,.0f} kW) + "
              f"{len(RADIAL_CODES)} tải nhánh | {d['label']}")
    bad = []
    for f in sorted(_ETAP_WRITTEN):
        e = verify_etap_file(f)
        if e:
            bad.append((os.path.relpath(f, OUT_PATTERN_DIR), e))
    n_all = len(_ETAP_WRITTEN)
    if bad:
        print(f"\n [!] {len(bad)}/{n_all} tệp KHÔNG đạt định dạng ETAP:")
        for f, e in bad[:10]:
            print(f"     {f}: {'; '.join(e)}")
    else:
        print(f"\n [+] Đã kiểm tra {n_all} tệp: đúng 13 cột, {N_SLOTS + 1} dòng, "
              f"không ô công thức, không ô rỗng ngoài cột V(p.u.).")
    print(f" Toàn bộ tại: {OUT_PATTERN_DIR}")


