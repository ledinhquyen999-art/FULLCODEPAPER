def ageing_decomposition(stations, nets_by_scen, profiles=None):
    """
    [V5.4] PHÂN RÃ NGUYÊN NHÂN thay đổi tổn thọ giữa các kịch bản.

    Lý do bắt buộc phải có phần này: tổn thọ là tích phân của V = 2^((θ_h−98)/6), một hàm LỒI theo
    nhiệt độ. Theo bất đẳng thức Jensen, với CÙNG một lượng năng lượng thì trải đều tải phải làm
    tích phân NHỎ đi, chứ không lớn lên. Vậy lời giải thích "cao nguyên tải làm dầu không kịp
    nguội" KHÔNG tự động đúng và phải được kiểm chứng.

    Ứng viên cạnh tranh: lịch tối ưu đẩy bơm vào giữa trưa để hấp thụ điện mặt trời, mà giữa trưa
    là lúc nhiệt độ môi trường cao nhất. Chênh 6 K của θ_a làm V nhân đôi, đúng bằng một hằng số
    của công thức lão hoá.

    Phép thử: tính lại tổn thọ với nhiệt độ môi trường GIỮ HẰNG SỐ bằng trung bình ngày.
      - chênh lệch co lại gần 0  -> cơ chế là DỊCH BƠM VÀO GIỜ NÓNG
      - chênh lệch giữ nguyên    -> cơ chế là HÌNH DẠNG ĐỒ THỊ TẢI
      - chênh lệch đảo dấu       -> cao nguyên thực ra CÓ LỢI, toàn bộ hiệu ứng do nhiệt độ
    """
    banner("[B5] PHÂN RÃ NGUYÊN NHÂN THAY ĐỔI TỔN THỌ (nhiệt độ môi trường vs hình dạng tải)")
    amb = ambient_profile()
    amb_const = np.full(N_SLOTS, float(np.mean(amb)))
    print(f" Nhiệt độ môi trường: {_AMBIENT['source']}")
    print(f"   biến thiên {np.min(amb):.1f}–{np.max(amb):.1f} °C, trung bình {np.mean(amb):.1f} °C;"
          f" chuỗi hằng số dùng để đối chứng = {np.mean(amb):.1f} °C\n")

    rows = []
    for sc, nets in nets_by_scen.items():
        lol_real = lol_flat = 0.0
        num = den = 0.0
        k_all = []
        for c, st in stations.items():
            if c not in nets:
                continue
            sn = nets[c]["s_net"]
            lol_real += iec_hotspot(sn, st["TRs"], theta_a=amb)["LoL_h_day"]
            lol_flat += iec_hotspot(sn, st["TRs"], theta_a=amb_const)["LoL_h_day"]
            k = sn / max(st["TRs"], 1e-9)
            k_all.append(k)
            num += float(np.sum(k ** 2 * amb)); den += float(np.sum(k ** 2))
        kk = np.array(k_all)
        rows.append({"Kịch bản": sc,
                     "ΣLoL θ_a thật": round(lol_real, 2),
                     "ΣLoL θ_a hằng số": round(lol_flat, 2),
                     "θ_a hiệu dụng (°C)": round(num / max(den, 1e-9), 2),
                     "K trung bình": round(float(np.mean(kk)), 3),
                     "K đỉnh": round(float(np.max(kk)), 3),
                     "Giờ K>0,8": round(float(np.sum(kk > 0.8)) * DT_H, 1)})
    df = pd.DataFrame(rows)
    print(df.to_string(index=False))

    if {"S2", "S3"} <= set(nets_by_scen):
        a = df.set_index("Kịch bản")
        d_real = (a.loc["S3", "ΣLoL θ_a thật"] - a.loc["S2", "ΣLoL θ_a thật"]) \
            / max(a.loc["S2", "ΣLoL θ_a thật"], 1e-9) * 100
        d_flat = (a.loc["S3", "ΣLoL θ_a hằng số"] - a.loc["S2", "ΣLoL θ_a hằng số"]) \
            / max(a.loc["S2", "ΣLoL θ_a hằng số"], 1e-9) * 100
        dta = a.loc["S3", "θ_a hiệu dụng (°C)"] - a.loc["S2", "θ_a hiệu dụng (°C)"]
        print(f"\n S3 so với S2:  với θ_a thật {d_real:+.1f}%  |  với θ_a hằng số {d_flat:+.1f}%")
        print(f" Nhiệt độ môi trường hiệu dụng (trọng số K²) dịch {dta:+.2f} °C")
        share = (1 - d_flat / d_real) * 100 if abs(d_real) > 1e-9 else np.nan
        print()
        if abs(d_real) < 1e-9:
            print(" [i] Không có chênh lệch để phân rã.")
        elif abs(d_flat) < 0.25 * abs(d_real):
            print(f" [+] CƠ CHẾ = DỊCH BƠM VÀO GIỜ NÓNG. Nhiệt độ môi trường giải thích "
                  f"{share:.0f}% hiệu ứng.")
            print("     Phải viết lại mục 3.4 theo cơ chế này; lời giải thích 'cao nguyên tải'")
            print("     KHÔNG đúng và phải bỏ. Kết luận của bài khi đó PHỤ THUỘC HOÀN TOÀN vào")
            print("     chuỗi nhiệt độ, nên việc dùng nhiệt độ đo thật là BẮT BUỘC, không còn tuỳ chọn.")
        elif d_flat * d_real < 0:
            print(" [!] ĐẢO DẤU khi giữ nhiệt độ hằng số: riêng hình dạng tải thì lời giải cực")
            print("     tiểu đỉnh CÓ LỢI cho tuổi thọ, toàn bộ hiệu ứng bất lợi đến từ việc dịch")
            print("     bơm vào giờ nóng. Đây mới là phát biểu đúng cho bài báo.")
        elif abs(d_flat) > 0.40 * abs(d_real):
            print(f" [+] CƠ CHẾ CHÍNH = HÌNH DẠNG ĐỒ THỊ TẢI ({100-share:.0f}% hiệu ứng), biến")
            print(f"     thiên nhiệt độ trong ngày KHUẾCH ĐẠI thêm ({share:.0f}%). Bài báo phải")
            print("     trình bày cả hai, nhưng cơ chế nền tảng là hình dạng tải.")
            print("     Lời giải thích 'cao nguyên tải kéo dài' được số liệu ủng hộ. Lưu ý vẫn phải")
            print("     biện luận vì sao hiệu ứng này thắng bất đẳng thức Jensen: nguyên nhân là")
            print("     mức mang tải từng máy KHÔNG giảm (xem cột K đỉnh), đỉnh xuất tuyến giảm")
            print("     chủ yếu nhờ các trạm không còn trùng giờ nhau.")
        else:
            print(f" [i] CẢ HAI CƠ CHẾ cùng đóng góp: nhiệt độ môi trường khoảng {share:.0f}%,")
            print("     hình dạng tải phần còn lại. Bài báo phải trình bày cả hai.")
        print("\n [i] Kiểm tra bổ trợ: nếu K đỉnh của S3 không thấp hơn K đỉnh của S2 thì việc giảm")
        print("     đỉnh XUẤT TUYẾN không đi kèm giảm mang tải TỪNG MÁY, và đó là điều kiện cần")
        print("     để tổn thọ có thể xấu đi.")

    # ---------------------------------------------------------------------------------------------
    # [V5.9] ĐỘ NHẠY THEO BIÊN ĐỘ NHIỆT ĐỘ NGÀY ĐÊM
    # Trung bình tháng tra được từ QCVN nên chắc chắn; biên độ ngày đêm kém chắc chắn hơn, vì vậy
    # nó phải được KHẢO SÁT chứ không được chọn một giá trị rồi coi như đã biết.
    # ---------------------------------------------------------------------------------------------
    if {"S2", "S3", "S3A"} <= set(nets_by_scen) and "sin" in _AMBIENT.get("source", ""):
        print("\n Độ nhạy theo biên độ nhiệt độ ngày đêm (trung bình tháng giữ nguyên "
              f"{TEMP_MEAN_C_SRC} oC):")
        rows2 = []
        for rng in TEMP_RANGE_SWEEP:
            amb_r = (TEMP_MEAN_C_SRC + (rng / 2.0) *
                     np.cos(2 * np.pi * (np.arange(N_SLOTS) * DT_H - TEMP_PEAK_HOUR) / 24.0))
            tot = {}
            for sc in ("S2", "S3", "S3A"):
                tot[sc] = sum(iec_hotspot(nets_by_scen[sc][c]["s_net"], st["TRs"],
                                          theta_a=amb_r)["LoL_h_day"]
                              for c, st in stations.items() if c in nets_by_scen[sc])
            rows2.append({"Biên độ (K)": rng,
                          "Tmin/Tmax (°C)": f"{TEMP_MEAN_C_SRC-rng/2:.1f} / {TEMP_MEAN_C_SRC+rng/2:.1f}",
                          "ΣL S2": round(tot["S2"], 2), "ΣL S3": round(tot["S3"], 2),
                          "ΣL S3A": round(tot["S3A"], 2),
                          "S3 vs S2 (%)": round((tot["S3"] - tot["S2"]) / max(tot["S2"], 1e-9) * 100, 1),
                          "S3A vs S3 (%)": round((tot["S3A"] - tot["S3"]) / max(tot["S3"], 1e-9) * 100, 1)})
        df2 = pd.DataFrame(rows2)
        print(df2.to_string(index=False))
        a3, b3 = df2["S3 vs S2 (%)"].values, df2["S3A vs S3 (%)"].values
        if np.all(a3 > 0) and np.all(b3 < 0):
            print(f" [+] Dấu của cả hai kết luận BẢO TOÀN trên toàn dải biên độ "
                  f"{min(TEMP_RANGE_SWEEP):.0f}–{max(TEMP_RANGE_SWEEP):.0f} K:")
            print(f"     S3 xấu hơn S2 từ {a3.min():+.1f}% đến {a3.max():+.1f}%; "
                  f"S3A tốt hơn S3 từ {b3.max():+.1f}% đến {b3.min():+.1f}%.")
            print("     => Kết luận KHÔNG phụ thuộc vào giá trị biên độ được chọn. Báo cáo dải này")
            print("        trong bài thay vì một con số đơn lẻ.")
        else:
            print(" [!] Dấu kết luận ĐỔI trong dải khảo sát -> phải tra đúng biên độ thật trước khi công bố.")
        _EXTRACT["df_temp_sens"] = df2

    # ---------------------------------------------------------------------------------------------
    # [V5.6] ĐỐI CHỨNG MÔ HÌNH NHỊ PHÂN — KHÔNG dùng để quy kết nguyên nhân tổn thọ.
    #
    # v5.5 dựng bảng giai thừa 2x2 với ô S3bin nhằm tách "hiệu ứng tiêu chí" khỏi "hiệu ứng mô
    # hình". Cách đặt vấn đề đó SAI và đã được gỡ bỏ, vì hai lý do:
    #   1) S2 KHÔNG phải lời giải của mô hình nhị phân. Nó là hiện trạng vận hành bóc tách từ đo
    #      xa và vốn đã ở dạng số tổ nguyên. Giữa S2 và S3 chỉ có đúng MỘT thay đổi là tối ưu hay
    #      không, nên so sánh S2 với S3 đã sạch, không cần tách.
    #   2) S3bin thường VI PHẠM ràng buộc nhiệt (5) tại các trạm bất khả thi, nên tổn thọ khổng lồ
    #      của nó phản ánh QUÁ TẢI chứ không phản ánh tiêu chí tối ưu.
    # Mục này vì vậy chỉ báo cáo S3bin như bằng chứng cho mục 3.2: mô hình nhị phân có hạ được
    # đỉnh, nhưng phải trả giá bằng quá tải.
    # ---------------------------------------------------------------------------------------------
    if "S3bin" in nets_by_scen:
        a2 = df.set_index("Kịch bản")
        kmax_bin = float(a2.loc["S3bin", "K đỉnh"])
        banner("[B6] ĐỐI CHỨNG MÔ HÌNH NHỊ PHÂN: HẠ ĐỈNH BẰNG CÁCH QUÁ TẢI", "-")
        if profiles is not None and "S3bin" in profiles:
            print(f" Đỉnh P_sys: S2 = {np.max(profiles['S2']):,.0f} kW | "
