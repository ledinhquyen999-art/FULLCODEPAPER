# 7. CÔNG SUẤT RÒNG CỦA TRẠM VÀ HÀM MỤC TIÊU
# =================================================================================================
def station_net(st, x, pv_roof=None):
    """
    Công suất qua MBA trạm i (16)-(17), có PV áp mái KHÔNG phát ngược qua MBA:
        P_tải = P_base + x·p_1tổ ;  Q_tải = Q_base + x·q_1tổ
        P_pv,dùng = min(P_pv, P_tải)          (zero-export)
        P_net = P_tải − P_pv,dùng ;  Q_net = Q_tải   (inverter cosφ = 1, không bù Q)
    ĐMT TRUNG THẾ KHÔNG xuất hiện ở đây: nó nối vào thanh cái trung thế nên không đổi tải MBA.
    """
    x = np.asarray(x)
    p_load = st["P_base"] + x * st["p_unit"]
    q_load = st["Q_base"] + x * st["q_unit"]
    if pv_roof is None:
        pv_gen = np.zeros(N_SLOTS)
        pv_used = np.zeros(N_SLOTS)
    else:
        pv_gen = np.clip(np.asarray(pv_roof, float), 0.0, None)
        pv_used = np.minimum(pv_gen, np.maximum(p_load, 0.0))
    p_net = p_load - pv_used
    q_net = q_load
    s_net = np.hypot(p_net, q_net)
    return {"p_net": p_net, "q_net": q_net, "s_net": s_net, "p_load": p_load, "q_load": q_load,
            "pv_gen": pv_gen, "pv_used": pv_used, "pv_curt": pv_gen - pv_used,
            "peak": float(np.max(s_net))}


def start_barrier(v, klim):
    """Số hạng rào khởi động: gần 0 khi xa giới hạn, tăng vọt khi sát S_start."""
    return START_BARRIER_W * float(np.sum((np.asarray(v, float) / max(klim, 1e-9)) ** 4))


def objective(P_kw, Q_kw, thermal_pen, ageing=0.0, w_age=0.0, load_kw=None,
              load_peak_guard=None, start_v=None, klim=None):
    """
    Hàm mục tiêu (27)-(30) (S, P tính bằng MW):
      J = Σ S² + W_FLAT (max S − min S)²             san bằng: Σ P = const nên Σ P² ≡ phương sai
        + W_REVERSE Σ[−P]⁺                          không phát ngược lên 110 kV (R8)
        + W_THERMAL Σ[S_i − 1,05 TRs_i]⁺ (kVA)      lưới an toàn; (R6) đã lọc cứng ở pool
        + w_age Σ_i L_i/24                          tuổi thọ cách điện IEC 60076-7
        + W_LOADPEAK (·)² + W_LOADPEAK_LIN [max P_tải − P_ngưỡng]⁺   đỉnh PHỤ TẢI THẬT <= S2 (R8)
        + START_BARRIER_W Σ (v/S_start)⁴            rào khởi động (R7 đã thực thi cứng)
    """
    P = np.asarray(P_kw, float) / 1000.0
    Q = np.asarray(Q_kw, float) / 1000.0
    S = np.hypot(P, Q)
    J = float(np.sum(S ** 2) + W_FLAT * (np.max(S) - np.min(S)) ** 2)
    J += W_REVERSE * float(np.sum(np.maximum(0.0, -P)))
    J += W_THERMAL * float(thermal_pen)
    if w_age and w_age > 0:
        J += float(w_age) * float(ageing)
    if load_peak_guard is not None and load_kw is not None:
        ex = float(max(0.0, np.max(load_kw) / 1000.0 - load_peak_guard))
        J += W_LOADPEAK * ex ** 2 + W_LOADPEAK_LIN * ex
    if start_v is not None and klim is not None:
        J += start_barrier(start_v, klim)
    return J


class Evaluator:
    """Đánh giá hàm mục tiêu cho một cấu hình (ĐMT trung thế, PV áp mái, w_age, ngưỡng đỉnh tải)."""

    def __init__(self, stations, others, pv_central, pv_roof=None, w_ageing=0.0,
                 load_peak_guard=None):
        self.st = stations
        self.pv_roof = pv_roof or {}
        self.w_age = float(w_ageing or 0.0)
        self.pv_cen = np.asarray(pv_central, float)
        self.load_peak_guard = load_peak_guard
        self.p_ind = np.sum([o["P"] for o in others["loads"].values()], axis=0)
        self.q_ind = np.sum([o["Q"] for o in others["loads"].values()], axis=0)
        self.p_fixed = self.p_ind - self.pv_cen
        self.q_fixed = self.q_ind.copy()
        self.klim = kstart_limit()
        self.codes = list(stations.keys())
        self.cache = {}

    def net(self, c, x):
        key = (c, np.asarray(x, np.int16).tobytes())
        v = self.cache.get(key)
        if v is None:
            if len(self.cache) > 300000:
                self.cache.clear()
            n = station_net(self.st[c], x, self.pv_roof.get(c))
            # [v9.3] Trạm KHÔNG có bơm không điều khiển được: phần vượt nhiệt của nó là hằng số, không
            # đưa vào J (tránh J khổng lồ vô nghĩa khi tăng tải); vẫn được báo cáo trong chỉ tiêu.
            over = (float(np.sum(np.maximum(0.0, n["s_net"] - TR_LIMIT * self.st[c]["TRs"])))
                    if self.st[c]["P_pump"] > 0 else 0.0)
            age = ageing_penalty(n["s_net"], self.st[c]["TRs"]) if self.w_age > 0 else 0.0
            v = (n, over, age)
            self.cache[key] = v
        return v

    def full(self, schedule):
        P = self.p_fixed.copy(); Q = self.q_fixed.copy()
        roof_used = np.zeros(N_SLOTS)
        pen = 0.0; age = 0.0; peaks = {}; nets = {}
        for c in self.codes:
            n, over, a = self.net(c, schedule[c])
            P = P + n["p_net"]; Q = Q + n["q_net"]; roof_used = roof_used + n["pv_used"]
            pen += over; age += a; peaks[c] = n["peak"]; nets[c] = n
        v = start_metric(schedule, self.st, self.codes)
        load = P + self.pv_cen + roof_used            # phụ tải thật (trước mọi PV)
        J = objective(P, Q, pen, age, self.w_age, load, self.load_peak_guard, v, self.klim)
        return {"J": J, "P_sys": P, "Q_sys": Q, "S_sys": np.hypot(P, Q), "P_load": load,
                "peaks": peaks, "nets": nets, "thermal_pen": pen, "ageing": age}


# =================================================================================================
# 8. GRASP + SIMULATED ANNEALING + TABU
# =================================================================================================
def priority_pi(stations, pools, unscheduled):
    max_pool = max(len(pools[c]) for c in pools) if pools else 1
    s_ref = max(st["S_pump"] for st in stations.values())
    return {c: (0.6 * (stations[c]["peak_pct_meas"] / 100.0)
                + 0.4 * (stations[c]["S_pump"] / max(s_ref, 1e-9))
                + 0.2 * (1.0 - len(pools[c]) / max(max_pool, 1))) for c in unscheduled}


def grasp_construct(stations, pools, active, ev, alpha, rng):
    """Xây dựng lời giải tuần tự theo π_i (31); chọn ngẫu nhiên đều trong RCL (32).
    α = 0 -> suy biến đúng về thuật toán tham lam của [1]. (R7) thực thi CỨNG; hàm chấm điểm
    dùng CHÍNH hàm objective() như pha tìm kiếm cục bộ (v9 F4)."""
    sched = {c: np.zeros(N_SLOTS, dtype=np.int16) for c in stations}
    unsched = set(active)
    P = ev.p_fixed.copy(); Q = ev.q_fixed.copy(); roof = np.zeros(N_SLOTS)
    pen_map, age_map, v_map, net_map = {}, {}, {}, {}
    for c in stations:
        n, over, a = ev.net(c, sched[c])
        P = P + n["p_net"]; Q = Q + n["q_net"]; roof = roof + n["pv_used"]
        pen_map[c] = over; age_map[c] = a; net_map[c] = n
        v_map[c] = (start_kva_of(sched[c], stations[c]["s_unit"])
                    if K_START_MODE == "kva" else starts_of(sched[c]).astype(float))
    v_agg = np.sum([v_map[c] for c in stations], axis=0)
    klim = kstart_limit()

    while unsched:
        pi = priority_pi(stations, pools, unsched)
        c_sel = max(pi, key=pi.get)
        n_old = net_map[c_sel]
        Pb = P - n_old["p_net"]; Qb = Q - n_old["q_net"]; Rb = roof - n_old["pv_used"]
        pen_b = sum(v for k, v in pen_map.items() if k != c_sel)
        age_b = sum(v for k, v in age_map.items() if k != c_sel)
        v_rest = v_agg - v_map[c_sel]
        s_unit = stations[c_sel]["s_unit"]

        scored = []
        for cand in pools[c_sel]:
            vc = (start_kva_of(cand, s_unit) if K_START_MODE == "kva"
                  else starts_of(cand).astype(float))
            if np.any(v_rest + vc > klim + 1e-6):
                continue                                     # (R7) cứng
            n, over, a = ev.net(c_sel, cand)
            Pn = Pb + n["p_net"]
            J = objective(Pn, Qb + n["q_net"], pen_b + over, age_b + a, ev.w_age,
                          Pn + ev.pv_cen + Rb + n["pv_used"], ev.load_peak_guard,
                          v_rest + vc, klim)
            scored.append((J, cand, vc, n, over, a))

        if not scored:
            # Không ứng viên nào thoả (R7) với các trạm đã xếp: lấy ứng viên vi phạm ÍT NHẤT
            # (hiếm; lời giải cuối vẫn bị kiểm tra (R7) và báo cáo nếu vi phạm).
            best = None
            for cand in pools[c_sel]:
                vc = (start_kva_of(cand, s_unit) if K_START_MODE == "kva"
                      else starts_of(cand).astype(float))
                ex = float(np.sum(np.maximum(0.0, v_rest + vc - klim)))
                if best is None or ex < best[0]:
                    best = (ex, cand, vc)
            _, cand, vc = best
            n, over, a = ev.net(c_sel, cand)
            scored = [(1e12, cand, vc, n, over, a)]

        scored.sort(key=lambda z: z[0])
        idx = int(rng.integers(0, max(1, int(np.ceil(alpha * len(scored))))))
        _, cand, vc, n, over, a = scored[idx]
        sched[c_sel] = cand; v_map[c_sel] = vc; v_agg = v_rest + vc; net_map[c_sel] = n
        P = Pb + n["p_net"]; Q = Qb + n["q_net"]; roof = Rb + n["pv_used"]
        pen_map[c_sel] = over; age_map[c_sel] = a
        unsched.discard(c_sel)
    return sched


def local_search(sched0, stations, pools, active, ev, rng, use_sa=True, use_tabu=True,
                 iters=SA_ITERS):
    cur = {c: np.array(sched0[c], dtype=np.int16) for c in sched0}
    cur_J = ev.full(cur)["J"]
    best = {c: cur[c].copy() for c in cur}; best_J = cur_J
    T = max(SA_T0_FRAC * abs(cur_J), 1e-3)
    tabu = []
    klim = kstart_limit()
    swap_pairs = [(a, b) for i, a in enumerate(active) for b in active[i + 1:]
                  if stations[a]["W_units"] == stations[b]["W_units"]
                  and stations[a]["n_units"] == stations[b]["n_units"]]
    p_swap = 0.20 if swap_pairs else 0.0

    for _ in range(iters):
        trial = {c: cur[c].copy() for c in cur}
        if swap_pairs and rng.random() < p_swap:
            ci, cj = swap_pairs[int(rng.integers(0, len(swap_pairs)))]
            trial[ci], trial[cj] = cur[cj].copy(), cur[ci].copy()
            sig = ("swap", ci, cj)
        else:
            c_r = active[int(rng.integers(0, len(active)))]
            cand = pools[c_r][int(rng.integers(0, len(pools[c_r])))]
            trial[c_r] = cand
            # [N8] Chữ ký theo THUỘC TÍNH (trạm, slot bắt đầu, mức số tổ) - không gian nhỏ nên
            # danh sách Tabu mới thực sự chặn được việc quay vòng. v3.0 dùng chữ ký gần như
            # định danh lời giải -> Tabu không bao giờ kích hoạt (đóng góp = 0 trên 20 seed).
            nz = np.nonzero(cand)[0]
            sig = ("move", c_r, int(nz[0]) if nz.size else -1,
                   int(np.max(cand)) if nz.size else 0)

        if np.any(start_metric(trial, stations, active) > klim + 1e-6):
            T *= SA_COOLING; continue
        new_J = ev.full(trial)["J"]
        if use_tabu and (sig in tabu) and not (new_J < best_J - 1e-9):
            T *= SA_COOLING; continue
        dJ = new_J - cur_J
        if dJ <= 0 or (use_sa and rng.random() < np.exp(-dJ / max(T, 1e-9))):
            cur = trial; cur_J = new_J
            if use_tabu:
                tabu.append(sig)
                if len(tabu) > TABU_LEN:
                    tabu.pop(0)
            if cur_J < best_J:
                best_J = cur_J; best = {c: cur[c].copy() for c in cur}
        T *= SA_COOLING
    return best, best_J


LAST_RUN = {}


def run_optimizer(stations, others, pv_central, pv_roof=None, seed=SEED_MAIN, mode="full",
                  verbose=True, w_ageing=0.0, load_peak_guard=None, pool_tag="", effort=None,
                  label="", pv_roof_thermal=None):
    """
    Giải bài toán lập lịch cho MỘT cấu hình nguồn:
      pv_central : ĐMT trung thế đưa vào hàm mục tiêu (mảng 0 = lịch "mù ĐMT")
      pv_roof    : dict {mã trạm: P_pv áp mái (kW)} hoặc None
      effort     : (số vòng GRASP, số bước SA) - None = (N_GRASP_RUNS, SA_ITERS)
    pool_tag PHẢI khác nhau khi pv_roof khác nhau (bộ lọc nhiệt (R6) phụ thuộc PV áp mái).
    """
    runs, iters = effort if effort is not None else (N_GRASP_RUNS, SA_ITERS)
    rng = np.random.default_rng(seed)
    # [v9.2] Bộ lọc nhiệt (R6) có thể dùng PV áp mái NGÀY XẤU (pv_roof_thermal) trong khi hàm mục
    # tiêu dùng PV ngày thiết kế (pv_roof): lịch phải an toàn nhiệt cả khi PV áp mái không phát đủ.
    active, pools, infeas, _, _ = build_candidate_pools(
        stations, verbose=verbose, tag=pool_tag,
        pv_roof=(pv_roof_thermal if pv_roof_thermal is not None else pv_roof))
    ev = Evaluator(stations, others, pv_central, pv_roof=pv_roof, w_ageing=w_ageing,
                   load_peak_guard=load_peak_guard)
    if not active:
        raise SystemExit(" [LỖI] Không trạm nào có lượng nước bơm > 0 sau bóc tách - kiểm tra dữ liệu và "
                         "phương pháp bóc tách (ví dụ file ngày mưa có chứa cả tải bơm).")
    n_runs = 1 if mode == "greedy" else int(runs)
    best_s, best_J = None, np.inf
    j_con, j_ls = [], []
    for k in range(n_runs):
        alpha = 0.0 if k == 0 else ALPHA_RCL
        if verbose:
            print(f"   [+] {label or 'Tối ưu'} | {mode} | seed={seed} | vòng {k+1}/{n_runs} "
                  f"(α={alpha})")
        s = grasp_construct(stations, pools, active, ev, alpha, rng)
        J0 = ev.full(s)["J"]
        j_con.append(J0)
        J = J0
        if mode in ("grasp_sa", "full"):
            s, J = local_search(s, stations, pools, active, ev, rng,
                                use_sa=True, use_tabu=(mode == "full"), iters=iters)
        j_ls.append(J)
        if J < best_J:
            best_J, best_s = J, {c: s[c].copy() for c in s}
    check_water_conservation(best_s, stations, tag=f"({label or mode})")
    LAST_RUN.update({"J_construct_best": float(min(j_con)),
                     "J_after_ls_best": float(min(j_ls)),
                     "ls_gain": float(min(j_con) - min(j_ls))})
    return best_s, best_J, ev, infeas


