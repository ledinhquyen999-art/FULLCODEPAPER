def _ambient_plausible(prof):
    """[v9 F1] Kiểm tra một chuỗi 48 mốc có phải nhiệt độ KHÔNG KHÍ hay không.
    Trả về (hợp lệ, lý do). Nhiệt độ tấm pin / tủ thiết bị thường vượt 45 °C giữa trưa và đạt
    đỉnh sớm (11:00-12:30) theo bức xạ; nhiệt độ không khí đạt đỉnh 13:00-15:00."""
    p = np.asarray(prof, float)
    if p.size != N_SLOTS or not np.isfinite(p).all():
        return False, "chuỗi không đủ 48 giá trị hữu hạn"
    tmax, tmin, tmean = float(np.max(p)), float(np.min(p)), float(np.mean(p))
    if tmax > AMB_MAX_PLAUSIBLE:
        return False, (f"T_max = {tmax:.1f} °C > {AMB_MAX_PLAUSIBLE:.0f} °C -> KHÔNG phải nhiệt độ "
                       "không khí (nhiều khả năng là nhiệt độ tấm pin/tủ thiết bị)")
    if not (AMB_MEAN_RANGE[0] <= tmean <= AMB_MEAN_RANGE[1]):
        return False, f"T trung bình = {tmean:.1f} °C ngoài dải {AMB_MEAN_RANGE}"
    if tmax - tmin > AMB_DIURNAL_MAX:
        return False, f"biên độ ngày đêm {tmax - tmin:.1f} K > {AMB_DIURNAL_MAX:.0f} K"
    if float(np.std(p)) < 0.5:
        return False, "gần như hằng số - không có biến thiên ngày đêm"
    h_pk = float(np.argmax(p)) * DT_H
    if not (AMB_PEAK_WINDOW_H[0] <= h_pk <= AMB_PEAK_WINDOW_H[1]):
        return False, f"đỉnh nhiệt độ lúc {hhmm(int(np.argmax(p)))} - ngoài khung giờ hợp lý"
    return True, ""


def init_ambient(scenario="best"):
    """
    [v9 F1] Thứ tự ưu tiên: (1) AMBIENT_MANUAL_24H; (2) cột nhiệt độ dò được trong file và
    VƯỢT QUA kiểm tra hợp lý vật lý; (3) mô hình sin hiệu chuẩn QCVN 02:2022/BXD (nóng nhất 14h).
    """
    t2m = None
    if AMBIENT_MANUAL_24H is not None and len(AMBIENT_MANUAL_24H) == 24:
        v = np.asarray(AMBIENT_MANUAL_24H, float)
        cand = np.interp(np.arange(N_SLOTS) * 0.5, np.arange(24), v, period=24)
        ok, why = _ambient_plausible(cand)
        if ok:
            t2m = cand
            _AMBIENT["file"] = "AMBIENT_MANUAL_24H (nhap tay trong ma nguon)"
            _AMBIENT["how"] = "24 gia tri theo gio -> noi suy 48 moc"
            print(" [+] Dùng chuỗi nhiệt độ NHẬP TAY (AMBIENT_MANUAL_24H).")
        else:
            print(f" [!] AMBIENT_MANUAL_24H BỊ LOẠI: {why}")
    found = [] if t2m is not None else _scan_temperature_files()
    _AMBIENT["rejected"] = []
    if found:
        print(" [i] Quét tìm nhiệt độ môi trường (chỉ nhận chuỗi đạt kiểm tra hợp lý vật lý):")
        for f, col, df, v, bad in found:
            prof, how = _to_daily_48(df, col, v)
            base = os.path.basename(f)
            if bad is None and prof is not None:
                ok, why = _ambient_plausible(prof)
                bad = None if ok else why
            elif prof is None:
                bad = bad or "không đưa được về 48 mốc"
            is_pv_plant = any(cc in base for cc in CENTRAL_PV_CODES)
            note = ("DÙNG ĐƯỢC - " + how) if bad is None else ("LOẠI - " + bad)
            print(f"     {base:45s} cột '{col}' | {v.size} giá trị | {note}")
            if bad is not None:
                _AMBIENT["rejected"].append((base, bad))
                if is_pv_plant:
                    print("       -> đây là file đo xa NHÀ MÁY ĐMT; cột nhiệt độ của nó là nhiệt độ")
                    print("          tấm pin/tủ inverter, không dùng làm nhiệt độ không khí cho MBA.")
                continue
            if t2m is None:
                t2m = prof
                _AMBIENT["file"] = base
                _AMBIENT["how"] = how
    else:
        print(" [i] Quét tìm nhiệt độ môi trường: không thấy file nào có cột nhiệt độ.")
        print("     Đã quét mọi .csv/.xlsx trong thư mục PVGIS và thư mục INPUT (kể cả thư mục con),")
        print(f"     tìm các tên cột: {sorted(TEMP_KEYS)}")
    if t2m is not None:
        _AMBIENT["profile"] = np.asarray(t2m, float)
        _AMBIENT["source"] = (f"DO THUC TE tu {_AMBIENT.get('file','?')} "
                              f"({_AMBIENT.get('how','?')})")
    else:
        _AMBIENT["profile"] = TEMP_MEAN_C + TEMP_AMPL_C * np.cos(
            2 * np.pi * (TIME_AXIS - TEMP_PEAK_HOUR) / 24.0)     # DẤU CỘNG: nóng nhất 14h
        _AMBIENT["source"] = (f"mo hinh sin hieu chuan QCVN Tmin={TEMP_TMIN_C} / Tmax={TEMP_TMAX_C} oC "
                              f"(dinh {TEMP_PEAK_HOUR:.0f}h)")
        if _AMBIENT["rejected"]:
            print(" [!] Không có chuỗi đo nào đạt kiểm tra -> dùng mô hình sin hiệu chuẩn QCVN.")
            print("     Nếu có nhiệt độ không khí thật của NGÀY ĐO (trạm khí tượng Kon Tum, ERA5, ...),")
            print("     nhập 24 giá trị vào AMBIENT_MANUAL_24H.")
    return _AMBIENT["profile"]


DRY_SEASON_MONTHS = [12, 1, 2, 3, 4]     # tháng mùa khô để lấy trung bình nhiệt độ
TEMP_KEYS = {"t2m", "temp", "temperature", "tamb", "t_amb", "ta", "nhiet do", "nhietdo",
             "air temperature", "dry bulb"}


def _scan_temperature_files():
    """[V5.7] Quét MỌI file csv/xlsx trong thư mục PVGIS và thư mục INPUT để tìm cột nhiệt độ.

    v5.6 chỉ dò trong các file đã đặt tên theo mẫu *_<kWp>kWp.* nên file PVGIS tải thô
    (Timeseries_*.csv) không bao giờ được quét. Ngoài ra nó lấy thẳng 48 dòng ĐẦU của file:
    với chuỗi năm 8760 dòng, điều đó tương đương lấy hai ngày đầu tháng Một và sai âm thầm.
    Hàm này xử lý cả ba dạng: 48 mốc, 24 giờ, và chuỗi năm 8760/8784 giờ.
    """
    cands = []
    for d in (PV_DIR, INPUT_DIR):
        if not os.path.isdir(d):
            continue
        for ext in ("csv", "xlsx", "xls", "txt"):
            cands += glob.glob(os.path.join(d, f"*.{ext}"))
            cands += glob.glob(os.path.join(d, "**", f"*.{ext}"), recursive=True)
    out, seen = [], set()
    for f in sorted(set(cands)):
        base = os.path.basename(f)
        if base in seen:
            continue
        seen.add(base)
        df = None
        for skip in (0, 8, 9, 10, 11, 12):          # PVGIS chèn nhiều dòng metadata ở đầu
            try:
                df = (pd.read_csv(f, skiprows=skip) if f.lower().endswith((".csv", ".txt"))
                      else pd.read_excel(f, skiprows=skip))
                if df.shape[1] >= 2 and _pick_col(df, TEMP_KEYS) is not None:
                    break
                df = None
            except Exception:
                df = None
        if df is None:
            continue
        col = _pick_col(df, TEMP_KEYS)
        if col is None:
            continue
        v = pd.to_numeric(df[col], errors="coerce").values.astype(float)
        v = v[np.isfinite(v)]
        # Loại bỏ: cột rỗng hoàn toàn (nhiều file đo xa có sẵn tiêu đề "Temp C" nhưng KHÔNG
        # có số liệu), giá trị phi vật lý, và chuỗi phẳng không mang thông tin ngày đêm.
        if v.size < 24 or not (-20 < np.nanmean(v) < 60):
            continue
        if float(np.nanmax(v) - np.nanmin(v)) < 1.0:
            out.append((f, col, df, v, "HẰNG SỐ - không có biến thiên ngày đêm"))
            continue
        out.append((f, col, df, v, None))
    return out


def _to_daily_48(df, col, v):
    """Đưa một chuỗi nhiệt độ bất kỳ về 48 mốc 30 phút của một ngày điển hình."""
    n = v.size
    if n == N_SLOTS:
        return v.copy(), "chuoi 48 moc 30 phut"
    if n == 24:
        return np.interp(np.arange(N_SLOTS) * 0.5, np.arange(24), v,
                         period=24), "chuoi 24 gio -> noi suy 48 moc"
    if n >= 8000:                                  # chuỗi năm -> trung bình theo giờ trong ngày
        tcol = None
        for c in df.columns:
            if str(c).strip().lower() in ("time", "date", "datetime", "timestamp", "time(utc)"):
                tcol = c
                break
        hours = None
        if tcol is not None:
            ts = pd.to_datetime(df[tcol].astype(str).str.replace(":", "", regex=False),
                                format="%Y%m%d%H%M", errors="coerce")
            if ts.isna().mean() > 0.5:
                ts = pd.to_datetime(df[tcol], errors="coerce")
            if ts.notna().mean() > 0.5:
                hours = ts.dt.hour.values[:n]
                months = ts.dt.month.values[:n]
                mask = np.isin(months, DRY_SEASON_MONTHS)
                if mask.sum() > 24 * 20:
                    v, hours = v[mask], hours[mask]
        if hours is None:
            hours = np.arange(n) % 24
        prof24 = np.array([np.nanmean(v[hours == h]) if np.any(hours == h) else np.nan
                           for h in range(24)])
        if np.isnan(prof24).any():
            prof24 = pd.Series(prof24).interpolate(limit_direction="both").values
        return (np.interp(np.arange(N_SLOTS) * 0.5, np.arange(24), prof24, period=24),
                f"chuoi nam {n} gio -> trung binh gio mua kho")
    if n > N_SLOTS:
        return v[:N_SLOTS].copy(), f"lay {N_SLOTS} moc dau cua chuoi {n}"
    return None, None


