# 10. QUÉT NGƯỠNG TIẾP NHẬN (HOSTING CAPACITY) ĐMT TRUNG THẾ
# =================================================================================================
def hosting_capacity_scan(stations, others, sched, pv_unit, label, pv_roof=None,
                          kwp_max=15000.0, kwp_step=100.0):
    """
    λ* = max{λ : max_t S_nguồn(t,λ) <= T110  ∧  min_{t∈D} P_nguồn(t,λ) >= −REVERSE_LIMIT}
    D = các slot có ĐMT phát (> 1% đỉnh). Quét theo kWp TUYỆT ĐỐI. PV áp mái (nếu có) giữ nguyên
    vì nó là một phần của tải ròng tại các trạm.
    Con số CÔNG BỐ phải quét ở ngày KHÔNG TƯỚI (tải tối thiểu); các dòng khác chỉ để minh hoạ.
    """
    P_load, Q_load, _, _, _ = feeder_profile(stations, others, sched, np.zeros(N_SLOTS), pv_roof)
    day = np.where(pv_unit > 0.01 * max(np.max(pv_unit), 1e-9))[0]
    rows, kwp_star, first_fail = [], 0.0, None
    kwp = 0.0
    while kwp <= kwp_max + 1e-9:
        P = P_load - (kwp / PV_UNIT_FILE_KWP) * pv_unit
        S = np.hypot(P, Q_load)
        ok_s = np.max(S) <= T110_KVA
        ok_rev = (np.min(P[day]) >= -REVERSE_LIMIT_KW) if day.size else True
        rows.append({"kWp": kwp, "S_source_max (kVA)": round(float(np.max(S)), 1),
                     "P_min ban ngày (kW)": round(float(np.min(P[day])) if day.size else np.nan, 1),
                     "Thoả T110": "CÓ" if ok_s else "Không",
                     "Không phát ngược": "CÓ" if ok_rev else "Không"})
        if ok_s and ok_rev:
            if first_fail is None:
                kwp_star = kwp
        elif first_fail is None:
            first_fail = (kwp, "T110" if not ok_s else "phát ngược ban ngày")
        kwp += kwp_step
    df = pd.DataFrame(rows)
    binding = first_fail[1] if first_fail else "chưa chạm giới hạn trong dải quét"
    print(f" [+] {label:40s}: λ* = {kwp_star:,.0f} kWp "
          f"({kwp_star/PV_CENTRAL_KWP:.2f} lần hiện hữu) | ràng buộc tới hạn: {binding}")
    return kwp_star, df


