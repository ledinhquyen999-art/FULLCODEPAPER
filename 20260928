def _edge_on_mask(P, Q, trs, p_rated, n_units, mode):
    """Trạng thái bơm theo phương pháp cạnh với một quy tắc kết hợp kênh cho trước."""
    global CHANNEL_COMBINE
    keep = CHANNEL_COMBINE
    try:
        CHANNEL_COMBINE = mode
        r = extract_edge(P, Q, trs, p_rated, n_units)
    finally:
        CHANNEL_COMBINE = keep
    return r


def validate_with_rainy(stations):
    """
    [v9.6] KIỂM CHỨNG ĐỘC LẬP khâu bóc tách bằng số đo NGÀY MÙA MƯA (không tưới) của chính các trạm.
    Ngày mưa KHÔNG tham gia bóc tách (phương pháp chính 'edge'), nên đây là phép thử độc lập.

    Chỉ tiêu cho từng trạm:
      s          hệ số hiệu chỉnh mùa = trung vị P_khô/P_mưa trên các slot chắc chắn không bơm
      ratio      trung bình tải nền bóc tách / trung bình (s·P_mưa) TRONG GIỜ BƠM
                 (1 = khớp; > 1 = còn sót tải bơm trong tải nền; < 1 = bóc quá tay)
      trần       % slot bơm mà công suất bơm bóc tách chạm P_lắp + công suất vượt trần trung bình
      kéo dài    số slot mà quy tắc 'hyst' thêm so với 'and' nằm trong cao điểm tối VÀ ở đó phần
                 vượt trên s·P_mưa < 0,5 công suất một tổ (tức phần thêm được giải thích bởi tải
                 sinh hoạt, không phải bơm) -> dấu hiệu kéo dài NHẦM
    Kết luận chung (ĐẠT/KHÔNG ĐẠT) theo VALID_RATIO_BAND, VALID_RATIO_FLOOR và số slot kéo dài nhầm.
    """
    rdir = _rainy_dir()
    if not rdir:
        print("\n [i] Không có thư mục ngày mưa -> không kiểm chứng độc lập được khâu bóc tách.")
        return None
    banner("[2d] KIỂM CHỨNG ĐỘC LẬP KHÂU BÓC TÁCH BẰNG NGÀY MÙA MƯA", "-")
    print(f" Thư mục: {rdir}")
    print(f" Phương pháp đang kiểm chứng: '{EXTRACTION_METHOD}', quy tắc kết hợp kênh '{CHANNEL_COMBINE}'")
    rows = []
    ev0 = int(round(EVENING_WINDOW_H[0] / DT_H)); ev1 = int(round(EVENING_WINDOW_H[1] / DT_H))
    for c, st in stations.items():
        if st["P_pump"] <= 0:
            continue
        fp = find_station_file(rdir, c)
        if not fp:
            continue
        try:
            pr, _, _, _ = read_etap_series(fp)
        except Exception:
            continue
        info = _EXTRACT["info"][c]
        P = np.asarray(st["P_meas"], float); Q = np.asarray(st["Q_meas"], float)
        on = np.asarray(st["x_S2"]) > 0
        b = np.asarray(st["P_base"], float)
        sc = _season_scale(P, pr, ~np.asarray(info["on"], bool))
        ref = sc * np.asarray(pr, float)
        r = float(np.corrcoef(b, ref)[0, 1]) if np.std(b) > 0 and np.std(ref) > 0 else np.nan
        ratio = float(np.mean(b[on]) / max(np.mean(ref[on]), 1e-9)) if on.any() else np.nan
        pump = np.asarray(info["pump"], float)
        capped = on & (pump >= st["P_pump"] - 1e-6)
        excess = np.maximum(0.0, P - ref - st["P_pump"])
        exc_mean = float(np.mean(excess[capped])) if capped.any() else 0.0
        exc_max = float(np.max(excess[capped])) if capped.any() else 0.0
        p1 = st["p_unit"]
        flag_cap = (capped.sum() >= 0.5 * max(on.sum(), 1) and exc_mean > 0.25 * st["P_pump"])
        sugg = (float(np.ceil((st["P_pump"] + exc_max) / max(p1, 1e-9)) * p1) if flag_cap else np.nan)
        # 'hyst' so với 'and': số slot thêm, và số slot thêm bị giải thích bởi tải sinh hoạt tối
        n_ext = n_bad_ext = 0
        e_and = np.nan
        if info.get("q_usable"):
            r_and = _edge_on_mask(P, Q, st["TRs"], st["P_pump"], st["n_units"], "and")
            e_and = float(np.sum(r_and["pump"]) * DT_H)
            if CHANNEL_COMBINE == "hyst":
                extra = np.asarray(info["on"], bool) & ~np.asarray(r_and["on"], bool)
                n_ext = int(extra.sum())
                evening = np.zeros(N_SLOTS, bool); evening[ev0:ev1 + 1] = True
                bad_ext = extra & evening & ((P - ref) < 0.5 * p1)
                n_bad_ext = int(bad_ext.sum())
        e_main = float(np.sum(pump) * DT_H)
        h_main = float(np.sum(np.asarray(info["on"], bool)) * DT_H)
        h_and = (float(np.sum(np.asarray(r_and["on"], bool)) * DT_H) if info.get("q_usable") else h_main)
        rows.append({"Mã": c, "Q dùng được": "có" if info.get("q_usable") else "không",
                     "P_bơm khai báo (kW)": st["P_pump"], "Hệ số mùa s": round(sc, 2),
                     "r (nền vs s·mưa)": round(r, 2),
                     "Tỉ số nền/(s·mưa) giờ bơm": round(ratio, 2),
                     "% slot chạm trần P_lắp": round(capped.sum() / max(on.sum(), 1) * 100, 0),
                     "Vượt trần TB (kW)": round(exc_mean, 1),
                     "P_bơm tối thiểu gợi ý (kW)": sugg,
                     "E bơm phương pháp chính (kWh)": round(e_main, 0),
                     "E bơm 'and' (kWh)": (round(e_and, 0) if e_and == e_and else np.nan),
                     "Slot 'hyst' thêm": n_ext, "Slot kéo dài nhầm (tối)": n_bad_ext,
                     "Giờ bơm chính (h)": h_main, "Giờ bơm 'and' (h)": h_and,
                     "Cảnh báo": "; ".join(x for x in [
                         "NGHI P_bơm khai báo THẤP" if flag_cap else "",
                         "bóc QUÁ TAY" if ratio == ratio and ratio < VALID_RATIO_FLOOR else "",
                         "kéo dài nhầm vào cao điểm tối" if n_bad_ext >= 2 else ""] if x)})
    if not rows:
        print(" [i] Thư mục mùa mưa không có file của các trạm bơm -> bỏ qua.")
        return None
    df = pd.DataFrame(rows)
    print(df.to_string(index=False))

    rr = df["Tỉ số nền/(s·mưa) giờ bơm"].dropna()
    med = float(rr.median()) if len(rr) else np.nan
    n_low = int((rr < VALID_RATIO_FLOOR).sum())
    n_badext = int((df["Slot kéo dài nhầm (tối)"] >= 2).sum())
    capst = list(df.loc[df["Cảnh báo"].str.contains("THẤP"), "Mã"])
    ok1 = VALID_RATIO_BAND[0] <= med <= VALID_RATIO_BAND[1]
    ok2 = n_low == 0
    ok3 = n_badext == 0
    print(f"\n TIÊU CHÍ KIỂM CHỨNG (công bố trước):")
    print(f"   (1) Trung vị tỉ số nền/(s·mưa) trong giờ bơm = {med:.2f} "
