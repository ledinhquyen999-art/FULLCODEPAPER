def pv_cell_temperature(t_amb, ghi):
    """Nhiệt độ tấm pin theo mô hình NOCT (Duffie & Beckman / Sandia đơn giản hoá).
    T_cell(t) = T_amb(t) + (NOCT - 20)/800 * G(t), G tính bằng W/m2.
    """
    t_amb = np.asarray(t_amb, float)
    ghi = np.asarray(ghi, float)
    return t_amb + (PV_NOCT - 20.0) / 800.0 * ghi


def pv_central_power(ghi, t_amb, kwp,
                     gamma=None, t_stc=None, derate=None):
    """[v8.0] Công suất phát ĐMT trung thế THẬT theo bức xạ G(t) và nhiệt độ môi trường T_amb(t),
    có suy giảm theo nhiệt độ tấm pin - THAY cho đường cong đơn vị nhân tỉ lệ công suất lắp đặt
    (cách làm của v7.4 trở về trước, không có hiệu ứng nhiệt).

        P_dc(t) = kWp * (G(t)/1000) * [1 + γ·(T_cell(t) - T_stc)] * derate_hệ_thống,  P_dc >= 0
    """
    gamma = PV_GAMMA_TEMP if gamma is None else gamma
    t_stc = PV_T_STC if t_stc is None else t_stc
    derate = PV_SYSTEM_DERATE if derate is None else derate
    ghi = np.asarray(ghi, float)
    t_cell = pv_cell_temperature(t_amb, ghi)
    p = float(kwp) * (ghi / 1000.0) * (1.0 + gamma * (t_cell - t_stc)) * derate
    return np.clip(p, 0.0, None)

