def _smooth_base_score(st, info):
    """Bước nhảy lớn nhất của tải nền tại các điểm bật/tắt bơm, chuẩn hoá theo TRs (nhỏ = mượt)."""
    b = np.asarray(st["P_base"], float)
    on = np.asarray(info.get("on", np.zeros(N_SLOTS, bool)), bool)
    edges = [t for t in range(1, N_SLOTS) if on[t] != on[t - 1]]
    if not edges:
        return 0.0
    return max(abs(b[t] - b[t - 1]) for t in edges) / max(st["TRs"], 1e-9)


