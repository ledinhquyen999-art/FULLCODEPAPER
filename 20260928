# 5. NHIỆT MBA THEO IEC 60076-7  (dùng cả để đánh giá VÀ trong hàm mục tiêu - tiêu chí B3)
# =================================================================================================
def iec_hotspot(s_kva, trs_kva, theta_a=None, n_cycle=2,
                tau_oil=None, dtheta_or=None, dtheta_hr=None):
    """
    Phương trình sai phân IEC 60076-7 cho MBA phân phối ONAN.
      dtheta_oil: quán tính tau_oil = 180 phút;  dtheta_hs: tau_wdg << dt -> tựa tức thời
      theta_h = theta_a + dtheta_oil + dtheta_hs
      V = 2^((theta_h - 98)/6)  (hệ số lão hoá tương đối)
    """
    tau_oil = IEC_TAU_OIL_MIN if tau_oil is None else float(tau_oil)
    dtheta_or = IEC_DTHETA_OR if dtheta_or is None else float(dtheta_or)
    dtheta_hr = IEC_DTHETA_HR if dtheta_hr is None else float(dtheta_hr)
    theta_a = ambient_profile() if theta_a is None else np.asarray(theta_a, float)
    K = np.asarray(s_kva, float) / max(trs_kva, 1e-9)
    dt_min = DT_H * 60.0
    r = (1.0 + IEC_R_RATIO * K ** 2) / (1.0 + IEC_R_RATIO)
    d_ss = dtheta_or * np.power(np.maximum(r, 1e-9), IEC_X_OIL)
    d_hs = dtheta_hr * np.power(np.maximum(K, 0.0), IEC_Y_WDG)

    d_oil = float(d_ss[0])
    oil = np.zeros(N_SLOTS)
    a = dt_min / tau_oil
    for _ in range(max(1, n_cycle)):          # chạy nhiều vòng ngày để triệt điều kiện đầu
        for t in range(N_SLOTS):
            d_oil += a * (d_ss[t] - d_oil)
            oil[t] = d_oil
    theta_h = theta_a + oil + d_hs
    V = np.power(2.0, (theta_h - IEC_THETA_REF) / 6.0)
    return {"theta_h": theta_h, "theta_oil": theta_a + oil, "V": V,
            "LoL_h_day": float(np.sum(V) * DT_H), "V_mean": float(np.mean(V)),
            "theta_h_max": float(np.max(theta_h)), "K_max": float(np.max(K)),
            "hours_above_limit": float(np.sum(theta_h > IEC_HS_LIMIT) * DT_H)}


def ageing_penalty(s_kva, trs_kva):
    """Số hạng tổn thọ trong hàm mục tiêu = tốc độ lão hoá trung bình ngày L_i/24.
    [v9 F5] Dùng CÙNG số vòng lặp nhiệt (n_cycle=2) như khi đánh giá/báo cáo."""
    return iec_hotspot(s_kva, trs_kva, n_cycle=2)["LoL_h_day"] / 24.0


