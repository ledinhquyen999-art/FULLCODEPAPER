                                    # quét ngưỡng tiếp nhận (hosting capacity), xem hosting_capacity_scan()
PV_GAMMA_TEMP      = -0.0040        # hệ số nhiệt độ công suất, 1/°C (mặc định, xem cảnh báo trên)
PV_T_STC           = 25.0           # nhiệt độ tham chiếu STC, °C
PV_NOCT            = 45.0           # Nominal Operating Cell Temperature, °C (mặc định)
PV_SYSTEM_DERATE   = 0.97           # tổn hao hệ thống ngoài nhiệt độ (dây dẫn, MBA nâng áp, bụi...)
