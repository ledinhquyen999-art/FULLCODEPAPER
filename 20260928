def roof_profiles(stations, eta, roof_per_kwp):
    """kWp_i = làm tròn LÊN bội ROOF_KWP_STEP của η·P_i^lắp; chỉ đặt tại trạm CÓ bơm."""
    kwp, prof = {}, {}
    if eta <= 0:
        return kwp, prof
    for c, st in stations.items():
        if st["P_pump"] <= 0:
            continue
        k = ROOF_KWP_STEP * np.ceil(eta * st["P_pump"] / ROOF_KWP_STEP - 1e-9)
        kwp[c] = float(k)
        prof[c] = k * np.asarray(roof_per_kwp, float)
    return kwp, prof


def evaluate(stations, others, sched, pv_cen, pv_roof=None, roof_kwp=None):
    """Kết quả đầy đủ của một kịch bản (lịch + cấu hình nguồn)."""
    P, Q, S, nets, roof_used = feeder_profile(stations, others, sched, pv_cen, pv_roof)
    return {"sched": sched, "P_sys": P, "Q_sys": Q, "S_sys": S,
            "P_load": P + np.asarray(pv_cen, float) + roof_used, "nets": nets,
            "roof_used": roof_used, "pv_cen": np.asarray(pv_cen, float), "pv_roof": pv_roof,
            "roof_kwp": roof_kwp or {}}


