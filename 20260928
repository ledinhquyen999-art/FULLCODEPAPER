def report_present_rules(stations):
    """Hiện trạng S2 có tuân theo các quy tắc vận hành (R3)-(R5) không - CHỈ BÁO CÁO."""
    rows = []
    for c, st in stations.items():
        if st["P_pump"] <= 0:
            continue
        e = validate_schedule(st["x_S2"], st, check_rules=True)
        rows.append({"Mã": c, "Tên": st["name"], "Số ca": len(_runs(st["x_S2"])),
                     "Giờ bơm": round(float(np.sum(st["x_S2"] > 0)) * DT_H, 1),
                     "Tổ tối thiểu khi chạy": int(np.min(st["x_S2"][st["x_S2"] > 0]))
                     if np.any(st["x_S2"] > 0) else 0,
                     "Vi phạm quy tắc": "; ".join(e) if e else "không"})
    df = pd.DataFrame(rows)
    n_bad = int((df["Vi phạm quy tắc"] != "không").sum()) if len(df) else 0
    print(f"\n Hiện trạng S2 so với quy tắc vận hành (R3)-(R5): {n_bad}/{len(df)} trạm KHÔNG tuân thủ.")
    if n_bad:
        print(df[df["Vi phạm quy tắc"] != "không"].to_string(index=False))
        print(" [i] Đây là mô tả hiện trạng (người dân tự vận hành), không phải lỗi của mô hình.")
    return df


def _kmax_diag(stations, r):
    """Trạm và thời điểm có K lớn nhất (trong các trạm có bơm) + thành phần P, Q tại đó."""
    best = None
    for c, st in stations.items():
        if st["P_pump"] <= 0:
            continue
        n = r["nets"][c]
        t = int(np.argmax(n["s_net"]))
        k = float(n["s_net"][t] / st["TRs"])
        if best is None or k > best[0]:
            best = (k, c, t, float(n["p_load"][t]), float(n["pv_used"][t]), float(n["p_net"][t]),
                    float(n["q_net"][t]), int(r["sched"][c][t]))
    return best


def rooftop_sweep(stations, others, pv_cen, roof_per_kwp, lpg, day, m_s3, r_s3,
                  roof_per_kwp_thermal=None):
    """
    [v9.1] Quét η (PV áp mái + lập lịch đồng thời, w_age = 0) và chọn η* theo quy tắc CÔNG BỐ
    TRƯỚC, không phát ngược lên 110 kV là điều kiện bắt buộc ở cả hai nhánh:
      (a) S3 CHƯA đạt K_max trạm bơm <= ROOF_K_TARGET: η nhỏ nhất đạt ngưỡng đó.
      (b) S3 ĐÃ đạt ngưỡng: PV áp mái không cần cho tiêu chí mang tải; η* = η nhỏ nhất giảm
          giờ-trạm K > K_HIGH ít nhất ROOF_HOURS_REDUCTION so với S3 mà K_max vẫn <= ngưỡng.
      Không mức nào thoả -> chọn η cho ΣL nhỏ nhất trong các mức giữ K_max <= ngưỡng (nếu có),
      ngược lại η cho K_max nhỏ nhất; in rõ để nêu trong bài.
    Kèm chẩn đoán tại điểm K_max: P_tải, PV tự dùng, P_net, Q_net - để giải thích trường hợp PV
    áp mái KHÔNG làm giảm (thậm chí làm tăng) mang tải khi Q không được bù.
    """
    banner("[5] PV ÁP MÁI TẠI TRẠM BƠM + LẬP LỊCH ĐỒNG THỜI - QUÉT ĐỘ THÂM NHẬP η")
    print(f" Mô hình: zero-export (không phát ngược qua MBA), inverter cosφ = 1, derate "
          f"{ROOF_PV_DERATE:.0%}; kWp_i = ⌈η·P_i^lắp / {ROOF_KWP_STEP:g}⌉·{ROOF_KWP_STEP:g}.")
    if roof_per_kwp_thermal is None:
        roof_per_kwp_thermal = roof_per_kwp
    print(f" Ràng buộc nhiệt (R6) tính với PV áp mái '{ROOF_THERMAL_BASIS}': đỉnh "
          f"{np.max(roof_per_kwp_thermal):.3f} kW/kWp (ngày thiết kế {np.max(roof_per_kwp):.3f}) -> lịch")
    print("     an toàn nhiệt cả khi PV áp mái không phát đủ; PV chỉ được dùng để GIẢM tổn thọ.")

    def row_of(eta, kwp, m, r, n_inf):
        k, c, t, pl, pv, pn, qn, x = _kmax_diag(stations, r)
        return {"η": eta, "Σ kWp": round(sum(kwp.values()), 0),
                "K_max trạm bơm": m["K_max trạm bơm"], "Giờ-trạm K>0,8": m["Giờ-trạm K>0,8"],
                "Số MBA >105%": m["Số MBA >105%"], "ΣL (h/ngày)": m["ΣL (h/ngày)"],
                "Pmax (kW)": m["Pmax (kW)"], "P_min ban ngày (kW)": m["P_min ban ngày (kW)"],
                "PV áp mái tự dùng (kWh)": m["PV áp mái tự dùng (kWh)"],
                "PV áp mái bị cắt (kWh)": m["PV áp mái bị cắt (kWh)"],
                "Trạm K_max": c, "Giờ K_max": hhmm(t), "Số tổ lúc K_max": x,
                "P_tải lúc K_max (kW)": round(pl, 1), "PV dùng lúc K_max (kW)": round(pv, 1),
                "P_net lúc K_max (kW)": round(pn, 1), "Q_net lúc K_max (kvar)": round(qn, 1),
                "Trạm vô nghiệm nhiệt": n_inf}

    rows = [row_of(0.0, {}, m_s3, r_s3, 0)]
    store = {}
    for eta in [e for e in ROOF_PEN_LEVELS if e > 0]:
        kwp, prof = roof_profiles(stations, eta, roof_per_kwp)
        _, prof_th = roof_profiles(stations, eta, roof_per_kwp_thermal)
        tag = f"roof{eta:.4f}_{ROOF_THERMAL_BASIS}"
        sc, J, ev, inf = run_optimizer(stations, others, pv_cen, pv_roof=prof, verbose=False,
                                       w_ageing=0.0, load_peak_guard=lpg, pool_tag=tag,
                                       effort=(ROOF_SWEEP_RUNS, ROOF_SWEEP_ITERS),
                                       label=f"η={eta:g}", pv_roof_thermal=prof_th)
        r = evaluate(stations, others, sc, pv_cen, prof, kwp)
        m = scenario_metrics(stations, r, day)
        rows.append(row_of(eta, kwp, m, r, len(inf)))
        store[eta] = (kwp, prof, prof_th)
    df = pd.DataFrame(rows)
    print(df[["η", "Σ kWp", "K_max trạm bơm", "Giờ-trạm K>0,8", "Số MBA >105%", "ΣL (h/ngày)",
              "Pmax (kW)", "P_min ban ngày (kW)", "PV áp mái tự dùng (kWh)",
              "PV áp mái bị cắt (kWh)"]].to_string(index=False))
    print("\n Chẩn đoán tại điểm mang tải lớn nhất (trạm có bơm):")
    print(df[["η", "Trạm K_max", "Giờ K_max", "Số tổ lúc K_max", "P_tải lúc K_max (kW)",
              "PV dùng lúc K_max (kW)", "P_net lúc K_max (kW)",
              "Q_net lúc K_max (kvar)"]].to_string(index=False))

    k0 = float(m_s3["K_max trạm bơm"]); h0 = float(m_s3["Giờ-trạm K>0,8"])
    worse = df[(df["η"] > 0) & (df["K_max trạm bơm"] > k0 + 1e-3)]
    if len(worse):
        print(f"\n [!] PHÁT HIỆN: ở η = {', '.join(f'{e:g}' for e in worse['η'])} PV áp mái cùng lịch san bằng")
        print(f"     làm K_max TĂNG so với S3 ({k0:.3f} -> tối đa {worse['K_max trạm bơm'].max():.3f}).")
        print("     Chẩn đoán theo từng mức (dựa trên P, Q tại điểm K_max, không suy đoán):")
        for _, w_ in worse.iterrows():
            pl, pv, pn, qn = (w_["P_tải lúc K_max (kW)"], w_["PV dùng lúc K_max (kW)"],
                              w_["P_net lúc K_max (kW)"], w_["Q_net lúc K_max (kvar)"])
            cover = pv / max(pl, 1e-9)
            if qn > pn:
                why_ = ("Q_net > P_net: thành phần PHẢN KHÁNG của động cơ chi phối, PV áp mái "
                        "(cosφ = 1) không bù được")
            elif cover < 0.30:
                why_ = (f"PV chỉ bù {cover:.0%} P_tải tại {w_['Giờ K_max']} (giờ nắng yếu): lịch san "
                        "bằng dồn thêm tổ bơm vào rìa vùng nắng")
            else:
                why_ = (f"PV bù {cover:.0%} P_tải nhưng lịch san bằng tăng số tổ chạy đồng thời lên "
                        f"{int(w_['Số tổ lúc K_max'])} tổ")
            print(f"       η={w_['η']:g}: {w_['Trạm K_max']} lúc {w_['Giờ K_max']} - {why_}.")
        print("     => Viết vào bài: PV áp mái KHÔNG tự động giảm tải MBA khi lịch vẫn tối ưu theo tiêu")
        print("        chí san bằng đầu nguồn; tải từng máy phải được đưa vào hàm mục tiêu (S4A).")

    # [v9.2] Quy tắc chọn η* theo TỔN THỌ (K_max là đại lượng cực trị, nhiễu, và đỉnh từng máy
    # thường rơi vào giờ nắng yếu nên PV áp mái không chạm tới): η* = η nhỏ nhất đạt
    # ROOF_KNEE_FRAC mức giảm ΣL lớn nhất của dải quét, trong các mức KHÔNG phát ngược lên 110 kV.
    L0 = float(m_s3["ΣL (h/ngày)"]); h0 = float(m_s3["Giờ-trạm K>0,8"])
    df["Giảm ΣL so với S3 (%)"] = ((L0 - df["ΣL (h/ngày)"]) / max(L0, 1e-9) * 100).round(1)
    df["Giảm giờ K>0,8 so với S3 (%)"] = ((h0 - df["Giờ-trạm K>0,8"]) / max(h0, 1e-9) * 100).round(1)
    pos = (df["η"] > 0) & (df["P_min ban ngày (kW)"] >= -REVERSE_LIMIT_KW)
    if ROOF_PEN_SELECTED is not None and ROOF_PEN_SELECTED in store:
        eta_s, why = float(ROOF_PEN_SELECTED), "chọn tay (ROOF_PEN_SELECTED)"
    else:
        cand = df[pos] if pos.any() else df[df["η"] > 0]
        g = cand["Giảm ΣL so với S3 (%)"].values
        tgt = ROOF_KNEE_FRAC * float(np.max(g))
        eta_s = float(cand["η"].values[int(np.where(g >= tgt - 1e-9)[0][0])])
        why = (f"η nhỏ nhất đạt {ROOF_KNEE_FRAC:.0%} mức giảm ΣL lớn nhất ({np.max(g):.1f}%)"
               + (" trong các mức không phát ngược lên 110 kV" if pos.any()
                  else "; [!] MỌI mức η đều gây phát ngược lên 110 kV -> phải nêu trong bài"))
    print(df[["η", "Σ kWp", "Giảm ΣL so với S3 (%)", "Giảm giờ K>0,8 so với S3 (%)"]]
          .to_string(index=False))
    print(f"\n [+] η* = {eta_s:g}  ({why})")
    r_ = df[df["η"] == eta_s].iloc[0]
    print(f"     Tại η*: ΣL {L0:.2f} -> {r_['ΣL (h/ngày)']:.2f} h/ngày, giờ-trạm K>0,8 {h0:.1f} -> "
          f"{r_['Giờ-trạm K>0,8']:.1f}, K_max trạm bơm {m_s3['K_max trạm bơm']:.3f} -> "
          f"{r_['K_max trạm bơm']:.3f} (chỉ báo cáo)")
    if (df.loc[df["η"] > 0, "P_min ban ngày (kW)"] < -REVERSE_LIMIT_KW).any():
        print(" [!] Ở một số mức η, xuất tuyến PHÁT NGƯỢC lên 110 kV giữa trưa: PV áp mái cạnh tranh")
        print("     cùng dư địa với ĐMT trung thế (xem mục ngưỡng tiếp nhận).")
    kwp_s, prof_s, prof_th_s = store[eta_s]
    return df, eta_s, kwp_s, prof_s, prof_th_s


def method_sensitivity(spec, dry, pv_cen, w_star, day, M_main, R_main):
    """
    [v9.6] DẢI BẤT ĐỊNH THEO PHƯƠNG PHÁP BÓC TÁCH: dựng lại toàn bộ dữ liệu trạm bằng quy tắc 'and'
    (cận dưới của lượng bơm), giải lại S3blind, S3, S3A (công sức rút gọn như quét Pareto, cùng w*,
    cùng trần đỉnh) và so các khẳng định chính với phương pháp chính. Khẳng định ĐẠT ở cả hai được
    viết chắc chắn; ĐẠT ở một phương pháp phải viết có điều kiện.
    """
    import contextlib, io, copy
    global CHANNEL_COMBINE
    if CHANNEL_COMBINE == "and" and EXTRACTION_METHOD == "edge":
        print("\n [i] Phương pháp chính đã là 'and' -> bỏ qua phân tích dải theo phương pháp.")
        return None
    banner("[B9] DẢI BẤT ĐỊNH THEO PHƯƠNG PHÁP BÓC TÁCH: phương pháp chính so với 'and' (cận dưới)")
    keep_c, keep_x = CHANNEL_COMBINE, copy.copy(_EXTRACT)
    buf = io.StringIO()
    try:
        CHANNEL_COMBINE = "and"
        with contextlib.redirect_stdout(buf):
            st_a, oth_a, _, _ = build_system_data(spec, dry)
    finally:
        CHANNEL_COMBINE = keep_c
        _EXTRACT.clear(); _EXTRACT.update(keep_x)
    zeros = np.zeros(N_SLOTS)
    s2 = {c: np.asarray(st["x_S2"], dtype=np.int16) for c, st in st_a.items()}
    p_ind = np.sum([o["P"] for o in oth_a["loads"].values()], axis=0)
    lp2 = float(np.max(p_ind + np.sum([station_net(st, s2[c])["p_load"]
                                       for c, st in st_a.items()], axis=0)))
    eff = (AGEING_SWEEP_RUNS, AGEING_SWEEP_ITERS)
    sb, _, _, _ = run_optimizer(st_a, oth_a, zeros, load_peak_guard=lp2 / 1000.0, pool_tag="m_and",
                                effort=eff, verbose=False, label="and S3blind")
    s3, _, _, _ = run_optimizer(st_a, oth_a, pv_cen, load_peak_guard=lp2 / 1000.0, pool_tag="m_and",
                                effort=eff, verbose=False, label="and S3")
    s3a_, _, _, _ = run_optimizer(st_a, oth_a, pv_cen, w_ageing=w_star, load_peak_guard=lp2 / 1000.0,
                                  pool_tag="m_and", effort=eff, verbose=False, label="and S3A")
    pk3 = float(np.max(feeder_profile(st_a, oth_a, s3, pv_cen)[0]))
    lim = pk3 * (1.0 + KNEE_PEAK_COST_CAP) + 0.5
    s3a = s3a_ if float(np.max(feeder_profile(st_a, oth_a, s3a_, pv_cen)[0])) <= lim else s3
    Ma = {k: scenario_metrics(st_a, evaluate(st_a, oth_a, sc, pv_cen), day)
          for k, sc in (("S2", s2), ("S3blind", sb), ("S3", s3), ("S3A", s3a))}
    pct = lambda a, b: (b - a) / max(abs(a), 1e-9) * 100
    L = "ΣL (h/ngày)"; P = "Pmax (kW)"; E = "E bơm (kWh)"
    rows = []
    specs = [
        ("E bơm (kWh/ngày)", lambda m: m["S2"][E], None),
        ("KĐ4: S3 vs S2 tổn thọ (%)", lambda m: pct(m["S2"][L], m["S3"][L]), lambda v: v > 0),
        ("KĐ5: S3A vs S3 tổn thọ (%)", lambda m: pct(m["S3"][L], m["S3A"][L]), lambda v: v < 0),
        ("KĐ6: S3A vs S2 đỉnh (%)", lambda m: pct(m["S2"][P], m["S3A"][P]), lambda v: v < 0),
        ("KĐ6: S3A vs S2 tổn thọ (%)", lambda m: pct(m["S2"][L], m["S3A"][L]), lambda v: v < 0),
        ("KĐ6: S3A vs S3blind tổn thọ (%)", lambda m: pct(m["S3blind"][L], m["S3A"][L]), lambda v: v < 0),
        ("KĐ4d: S3blind -> S3 tổn thọ (%)", lambda m: pct(m["S3blind"][L], m["S3"][L]), lambda v: v > 0),
    ]
    for name, fn, test in specs:
        try:
            vm, va = float(fn(M_main)), float(fn(Ma))
        except Exception:
            continue
        both = (test(vm) and test(va)) if test else None
        rows.append({"Chỉ tiêu": name, "Phương pháp chính": round(vm, 2), "'and' (cận dưới)": round(va, 2),
                     "Kết luận": ("—" if test is None else "ĐẠT cả hai -> viết chắc chắn" if both else
                                  "chỉ đạt một -> viết CÓ ĐIỀU KIỆN" if (test(vm) or test(va)) else
                                  "KHÔNG đạt")})
    df = pd.DataFrame(rows)
    print(df.to_string(index=False))
    print(" [i] Kết quả 'and' dùng công sức tìm kiếm rút gọn; báo cáo dạng dải [cận dưới, chính] trong bài.")
    return df


def load_growth_study(stations, others, pv_cen, w_star, day):
    """
    [v9.2] Độ nhạy theo TĂNG TRƯỞNG TẢI NỀN (sinh hoạt + tải nhánh nhân (1+g); lượng nước tưới và
    lịch hiện trạng giữ nguyên). Trả lời câu hỏi của phản biện: ở mức tải hiện tại đội MBA lão hoá
    chậm hơn chuẩn nhiều, vậy khi nào tiêu chí tổn thọ trở thành ràng buộc thực sự?
    Mỗi mức g: dựng lại tập ứng viên (lọc nhiệt đổi theo tải nền), giải lại S3 và S3A (cùng w*,
    cùng trần chi phí đỉnh), công sức tìm kiếm rút gọn như quét Pareto.
    """
    banner("[B8] ĐỘ NHẠY TĂNG TRƯỞNG TẢI NỀN - KHI NÀO TỔN THỌ TRỞ THÀNH RÀNG BUỘC")
    rows = []
    for gr in [0.0] + [x for x in LOAD_GROWTH_LEVELS if x > 0]:
        st_g = {}
        for c, st in stations.items():
            d = dict(st)
            d["P_base"] = st["P_base"] * (1 + gr)
            d["Q_base"] = st["Q_base"] * (1 + gr)
            st_g[c] = d
        oth_g = {"loads": {k: {"P": v["P"] * (1 + gr), "Q": v["Q"] * (1 + gr)}
                           for k, v in others["loads"].items()}}
        s2 = {c: np.asarray(st["x_S2"], dtype=np.int16) for c, st in st_g.items()}
        p_ind = np.sum([o["P"] for o in oth_g["loads"].values()], axis=0)
        lp2 = float(np.max(p_ind + np.sum([station_net(st, s2[c])["p_load"]
                                           for c, st in st_g.items()], axis=0)))
        tag = f"growth{gr:.3f}"
        eff = (AGEING_SWEEP_RUNS, AGEING_SWEEP_ITERS)
        s3, _, _, inf = run_optimizer(st_g, oth_g, pv_cen, load_peak_guard=lp2 / 1000.0,
                                      pool_tag=tag, effort=eff, verbose=False, label=f"g={gr:+.0%} S3")
        # w* được chọn ở mức tải hiện tại; thang của Σ S² thay đổi theo tải nên thử thêm w*/4, w*/2
        cands = []
        for wq in sorted({w_star / 4.0, w_star / 2.0, w_star}):
            sq, _, _, _ = run_optimizer(st_g, oth_g, pv_cen, w_ageing=wq,
                                        load_peak_guard=lp2 / 1000.0, pool_tag=tag, effort=eff,
                                        verbose=False, label=f"g={gr:+.0%} w={wq:g}")
            cands.append((f"w={wq:g}", sq))
        cands.append(("S3", s3))
        pk3 = float(np.max(feeder_profile(st_g, oth_g, s3, pv_cen)[0]))
        # chọn theo TỔN THỌ trong trần chi phí đỉnh (không theo J(w*), vì thang J đổi theo tải)
        lim = pk3 * (1.0 + KNEE_PEAK_COST_CAP) + 0.5
        ok_ = [(total_loss_of_life(st_g, evaluate(st_g, oth_g, sq, pv_cen)["nets"]), n_, sq)
               for n_, sq in cands
               if float(np.max(feeder_profile(st_g, oth_g, sq, pv_cen)[0])) <= lim]
        ok_.sort(key=lambda z: z[0])
        s3a = ok_[0][2] if ok_ else s3
        print(f"     g={gr:+.0%}: S3A lấy '{ok_[0][1] if ok_ else 'S3'}' (ΣL nhỏ nhất trong trần đỉnh "
              f"+{KNEE_PEAK_COST_CAP:.0%}); trạm vô nghiệm nhiệt: {inf if inf else 'không'}")
        m = {k: scenario_metrics(st_g, evaluate(st_g, oth_g, sc, pv_cen), day)
             for k, sc in (("S2", s2), ("S3", s3), ("S3A", s3a))}
        r2 = evaluate(st_g, oth_g, s2, pv_cen); r3a = evaluate(st_g, oth_g, s3a, pv_cen)
        L2, L3, LA = (m[k]["ΣL (h/ngày)"] for k in ("S2", "S3", "S3A"))
        rows.append({"Tăng trưởng tải nền": f"{gr:+.0%}",
                     "Trạm vô nghiệm nhiệt": len(inf),
                     "S2 hợp lệ nhiệt (R6)": "có" if all(
                         evaluate(st_g, oth_g, s2, pv_cen)["nets"][c]["peak"] <= TR_LIMIT * st["TRs"] + 1e-6
                         for c, st in st_g.items() if st["P_pump"] > 0) else "KHÔNG",
                     "Đỉnh S2 (kW)": m["S2"]["Pmax (kW)"], "Đỉnh S3 (kW)": m["S3"]["Pmax (kW)"],
                     "Đỉnh S3A (kW)": m["S3A"]["Pmax (kW)"],
                     "ΣL S2": L2, "ΣL S3": L3, "ΣL S3A": LA,
                     "ΣL S2 / mức chuẩn (%)": round(L2 / (24.0 * len(stations)) * 100, 1),
                     "S3 vs S2 (%)": round((L3 - L2) / max(L2, 1e-9) * 100, 1),
                     "S3A vs S2 (%)": round((LA - L2) / max(L2, 1e-9) * 100, 1),
                     "MBA lão hoá > chuẩn S2/S3/S3A": f"{m['S2']['Số MBA lão hoá > chuẩn']}/"
                                                       f"{m['S3']['Số MBA lão hoá > chuẩn']}/"
                                                       f"{m['S3A']['Số MBA lão hoá > chuẩn']}",
                     "MBA >105% S2/S3/S3A": f"{m['S2']['Số MBA >105%']}/{m['S3']['Số MBA >105%']}/"
                                            f"{m['S3A']['Số MBA >105%']}",
                     "Giá trị tuổi thọ S3A vs S2 (tr.VNĐ/năm)":
                         round(ageing_value_vnd_year(st_g, r2["nets"], r3a["nets"]) / 1e6, 1)})
    df = pd.DataFrame(rows)
    print(df.to_string(index=False))
    print(" [i] Dòng +0% dùng công sức tìm kiếm rút gọn nên có thể lệch nhẹ so với S3/S3A ở mục [7].")
    print(" [i] Khi 'S2 hợp lệ nhiệt' = KHÔNG, hiện trạng đã vượt 105% ở trạm có bơm: so sánh S3 với S2")
    print("     lúc đó là so với một lịch VI PHẠM, không phải mốc công bằng -> chỉ so S3A với S3.")
    print(" [i] Cách đọc: cột 'ΣL S2 / mức chuẩn' cho biết đội MBA đang dùng bao nhiêu phần trăm")
    print("     'ngân sách' tuổi thọ; khi mức này tiến gần 100% hoặc xuất hiện MBA lão hoá > chuẩn,")
    print("     tiêu chí tổn thọ chuyển từ 'đúng chiều' sang 'ràng buộc thực sự'.")
    return df


def claims_check(stations, M, R):
    """[v9 F9] Kiểm định từng khẳng định của bài bằng đúng phép so sánh một-biến tương ứng."""
    banner("[CLAIMS] KIỂM ĐỊNH CÁC KHẲNG ĐỊNH CỦA BÀI (chỉ viết vào bài những dòng ĐẠT)")
    rows = []

    def add(cid, text, comp, nums, ok):
        rows.append({"KĐ": cid, "Khẳng định": text, "Phép so sánh": comp, "Số liệu": nums,
                     "Kết quả": "ĐẠT" if ok else "KHÔNG ĐẠT"})

    g = lambda k, f: M[k][f]
    # KĐ1 - giá trị của việc lập lịch CÓ xét ĐMT
    if {"S0", "S0opt", "S3blind", "S3"} <= set(M):
        ok = (g("S3", "Pmax (kW)") <= g("S3blind", "Pmax (kW)") + 0.5
              and g("S3", "Std (kW)") < g("S3blind", "Std (kW)"))
        add("KĐ1", "Lập lịch CÓ xét ĐMT trung thế tốt hơn lịch KHÔNG xét ĐMT (cách của [1])",
            "S3blind -> S3 (cùng ĐMT, cùng nước)",
            f"đỉnh {g('S3blind','Pmax (kW)'):,.0f}->{g('S3','Pmax (kW)'):,.0f} kW; "
            f"std {g('S3blind','Std (kW)'):,.0f}->{g('S3','Std (kW)'):,.0f} kW; LF "
            f"{g('S3blind','LF'):.3f}->{g('S3','LF'):.3f}; chuỗi đỉnh S0/S0opt/S3blind/S3 = "
            f"{g('S0','Pmax (kW)'):,.0f}/{g('S0opt','Pmax (kW)'):,.0f}/"
            f"{g('S3blind','Pmax (kW)'):,.0f}/{g('S3','Pmax (kW)'):,.0f} kW", ok)
    # KĐ2 - ĐMT trung thế không đổi tải MBA
    if {"S0opt", "S3blind"} <= set(R):
        dk = max(float(np.max(np.abs(R["S0opt"]["nets"][c]["s_net"]
                                     - R["S3blind"]["nets"][c]["s_net"])))
                 for c in stations)
        add("KĐ2", "ĐMT trung thế KHÔNG giảm được tải MBA phân phối (chỉ giảm tải đầu nguồn)",
            "S0opt -> S3blind (cùng lịch, chỉ thêm ĐMT)",
            f"max|ΔS_net,i| = {dk:.2e} kVA; ΣL {g('S0opt','ΣL (h/ngày)'):.2f} = "
            f"{g('S3blind','ΣL (h/ngày)'):.2f}; đỉnh nguồn {g('S0opt','Pmax (kW)'):,.0f} -> "
            f"{g('S3blind','Pmax (kW)'):,.0f} kW", dk < 1e-6)
    pct = lambda a, b: (b - a) / max(abs(a), 1e-9) * 100
    # KĐ3 - PV áp mái + lịch giảm tải MBA (đo bằng giờ mang tải cao và tổn thọ; K_max chỉ báo cáo)
    if {"S3", "S4"} <= set(M):
        ok = (g("S4", "Giờ-trạm K>0,8") < g("S3", "Giờ-trạm K>0,8")
              and g("S4", "ΣL (h/ngày)") < g("S3", "ΣL (h/ngày)")
              and g("S4", "Số MBA >105%") == 0)
        add("KĐ3", "PV áp mái + lập lịch đồng thời GIẢM TẢI MBA phân phối (an toàn nhiệt ngày xấu)",
            "S3 -> S4 (thêm PV áp mái, tối ưu lại lịch)",
            f"giờ-trạm K>0,8 {g('S3','Giờ-trạm K>0,8'):.1f}->{g('S4','Giờ-trạm K>0,8'):.1f}; "
            f"ΣL {g('S3','ΣL (h/ngày)'):.2f}->{g('S4','ΣL (h/ngày)'):.2f} "
            f"({pct(g('S3','ΣL (h/ngày)'), g('S4','ΣL (h/ngày)')):+.1f}%); K_max trạm bơm "
            f"{g('S3','K_max trạm bơm'):.3f}->{g('S4','K_max trạm bơm'):.3f} (báo cáo)", ok)
        pm3, pm4 = g("S3", "P_min ban ngày (kW)"), g("S4", "P_min ban ngày (kW)")
        add("KĐ3b", "(quan sát) PV áp mái ĐÀO SÂU hố trưa của đường tải ròng đầu nguồn (>= 10%)",
            "S3 -> S4",
            f"P_min ban ngày {pm3:,.0f}->{pm4:,.0f} kW ({pct(pm3, pm4):+.1f}%); std "
            f"{g('S3','Std (kW)'):,.0f}->{g('S4','Std (kW)'):,.0f} kW (chỉ báo cáo)",
            pct(pm3, pm4) <= -10.0)
    # KĐ4 - độ phẳng KHÔNG quyết định tổn thọ
    if {"S2", "S3"} <= set(M):
        flatter = g("S3", "LF") > g("S2", "LF") and g("S3", "Std (kW)") < g("S2", "Std (kW)")
        worse = g("S3", "ΣL (h/ngày)") > g("S2", "ΣL (h/ngày)")
        add("KĐ4", "San bằng đường tải ròng (có ĐMT) làm đồ thị phẳng hơn nhưng TĂNG tổn thọ",
            "S2 -> S3 (cùng nước, cùng ĐMT, chỉ đổi lịch)",
            f"LF {g('S2','LF'):.3f}->{g('S3','LF'):.3f}; ΣL {g('S2','ΣL (h/ngày)'):.2f}->"
            f"{g('S3','ΣL (h/ngày)'):.2f} ({pct(g('S2','ΣL (h/ngày)'), g('S3','ΣL (h/ngày)')):+.1f}%)",
            flatter and worse)
    if {"S3", "S3A"} <= set(M):
        dlf = abs(g("S3", "LF") - g("S3A", "LF"))
        ratio = g("S3", "ΣL (h/ngày)") / max(g("S3A", "ΣL (h/ngày)"), 1e-9)
        add("KĐ4c", "Độ phẳng KHÔNG quyết định tổn thọ: hai lịch phẳng như nhau, tổn thọ khác xa",
            "S3 vs S3A",
            f"|ΔLF| = {dlf:.3f}; ΣL {g('S3','ΣL (h/ngày)'):.2f} vs {g('S3A','ΣL (h/ngày)'):.2f} "
            f"(gấp {ratio:.2f} lần)", dlf < 0.02 and ratio > 1.2)
    if {"S0", "S0opt", "S3blind", "S3"} <= set(M):
        a1 = pct(g("S0", "ΣL (h/ngày)"), g("S0opt", "ΣL (h/ngày)"))
        a2 = pct(g("S3blind", "ΣL (h/ngày)"), g("S3", "ΣL (h/ngày)"))
        add("KĐ4d", "Cơ chế: san bằng KHÔNG ĐMT đổi tổn thọ ít (|Δ| < 10%); tăng mạnh khi nén bơm vào cửa sổ nắng",
            "S0 -> S0opt  và  S3blind -> S3",
            f"ΣL không ĐMT {a1:+.1f}%; ΣL có ĐMT {a2:+.1f}%; tỉ lệ E bơm giờ nắng "
            f"{g('S3blind','Tỉ lệ E bơm giờ nắng (%)'):.1f}% -> {g('S3','Tỉ lệ E bơm giờ nắng (%)'):.1f}%; "
            f"θ_a hiệu dụng {g('S3blind','θ_a hiệu dụng K² (°C)'):.2f} -> "
            f"{g('S3','θ_a hiệu dụng K² (°C)'):.2f} °C", abs(a1) < 10.0 and a2 >= a1 + 10.0)
    if {"S4", "S4A"} <= set(M):
        add("KĐ4b", "Lịch san bằng CÓ PV áp mái vẫn chưa tối ưu về tổn thọ",
            "S4 -> S4A (chỉ thêm tiêu chí tổn thọ)",
            f"ΣL {g('S4','ΣL (h/ngày)'):.2f}->{g('S4A','ΣL (h/ngày)'):.2f} h/ngày "
            f"({pct(g('S4','ΣL (h/ngày)'), g('S4A','ΣL (h/ngày)')):+.1f}%)",
            g("S4A", "ΣL (h/ngày)") < g("S4", "ΣL (h/ngày)") - 1e-6)
    # KĐ5 - tối ưu có xét tuổi thọ
    if {"S3", "S3A"} <= set(M):
        dp = pct(g("S3", "Pmax (kW)"), g("S3A", "Pmax (kW)"))
        dl = pct(g("S3", "ΣL (h/ngày)"), g("S3A", "ΣL (h/ngày)"))
        add("KĐ5", "Đưa tổn thọ IEC vào hàm mục tiêu giảm tổn thọ với chi phí đỉnh nhỏ",
            "S3 -> S3A (chỉ thêm w_age)",
            f"ΣL {dl:+.1f}%, đỉnh {dp:+.2f}% (trần {KNEE_PEAK_COST_CAP*100:.0f}%)",
            dl < -1e-6 and dp <= KNEE_PEAK_COST_CAP * 100 + 1e-6)
    # KĐ6 - lời giải khuyến nghị trội cả hiện trạng lẫn lịch không xét ĐMT
    if {"S2", "S3blind", "S3A"} <= set(M):
        oks = []
        txt = []
        for ref in ("S2", "S3blind"):
            dp_ = pct(g(ref, "Pmax (kW)"), g("S3A", "Pmax (kW)"))
            dl_ = pct(g(ref, "ΣL (h/ngày)"), g("S3A", "ΣL (h/ngày)"))
            oks.append(dp_ < 0 and dl_ < 0)
            txt.append(f"so {ref}: đỉnh {dp_:+.1f}%, ΣL {dl_:+.1f}%")
        add("KĐ6", "S3A TRỘI đồng thời hiện trạng và lịch không xét ĐMT (đỉnh và tổn thọ)",
            "S2, S3blind -> S3A", "; ".join(txt), all(oks))
    # KĐ7 - an toàn khi ĐMT trung thế ngừng phát (đỉnh = đỉnh phụ tải thật)
    if {"S2", "S3A"} <= set(M):
        add("KĐ7", "Khi ĐMT trung thế NGỪNG PHÁT, S3A không làm đỉnh xấu hơn hiện trạng",
            "đỉnh phụ tải thật S2 vs S3A",
            f"{g('S2','Pmax tải thật (kW)'):,.0f} vs {g('S3A','Pmax tải thật (kW)'):,.0f} kW",
            g("S3A", "Pmax tải thật (kW)") <= g("S2", "Pmax tải thật (kW)") + 0.5)
    df = pd.DataFrame(rows)
    for _, r in df.iterrows():
        print(f"\n [{r['Kết quả']:^9s}] {r['KĐ']}: {r['Khẳng định']}")
        print(f"             So sánh: {r['Phép so sánh']}")
        print(f"             Số liệu: {r['Số liệu']}")
    bad = df[df["Kết quả"] != "ĐẠT"]
    if len(bad):
        print("\n [!] Các khẳng định KHÔNG ĐẠT phải được viết lại hoặc bỏ khỏi bài; KHÔNG được dùng")
        print("     câu chữ của bản thảo cũ cho các khẳng định này.")
    else:
        print("\n [+] Mọi khẳng định đều được số liệu ủng hộ trên bộ dữ liệu này.")
    return df


def robustness_check(stations, others, R, conds, day):
    """[v9 F10] Lịch đã tối ưu (không tối ưu lại) trong điều kiện nguồn khác ngày thiết kế."""
    banner("[B7] ĐỘ BỀN CỦA LỊCH TỐI ƯU KHI NGUỒN ĐMT THAY ĐỔI (không tối ưu lại)")
    rows = []
    for cname, (pv_c, roof_unit) in conds.items():
        for k in ["S2", "S3blind", "S3", "S3A", "S4", "S4A"]:
            if k not in R:
                continue
            kwp = R[k].get("roof_kwp") or {}
            roof = {c: v * roof_unit for c, v in kwp.items()} if kwp else None
            r = evaluate(stations, others, R[k]["sched"], pv_c, roof, kwp)
            m = scenario_metrics(stations, r, day)
            rows.append({"Điều kiện": cname, "Kịch bản": k, "Pmax ròng (kW)": m["Pmax (kW)"],
                         "P_min ban ngày (kW)": m["P_min ban ngày (kW)"],
                         "K_max trạm bơm": m["K_max trạm bơm"], "Số MBA >105%": m["Số MBA >105%"],
                         "ΣL (h/ngày)": m["ΣL (h/ngày)"]})
    df = pd.DataFrame(rows)
    print(df.to_string(index=False))
    for cname in conds:
        sub = df[df["Điều kiện"] == cname].set_index("Kịch bản")
        if {"S3", "S3blind"} <= set(sub.index):
            d = sub.loc["S3", "Pmax ròng (kW)"] - sub.loc["S3blind", "Pmax ròng (kW)"]
            print(f" [{'!' if d > 0.5 else '+'}] {cname}: đỉnh ròng lịch CÓ xét ĐMT so với lịch "
                  f"KHÔNG xét ĐMT: {d:+,.0f} kW"
                  + (" -> lịch bám ĐMT chịu rủi ro khi ĐMT không phát; phải nêu trong bài."
                     if d > 0.5 else ""))
    return df
