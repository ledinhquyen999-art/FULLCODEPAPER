def _pareto_table(ws, raw, store):
    """Dựng bảng Pareto từ các lời giải đã có: lọc không đơn điệu (thay CẢ HÀNG), đánh dấu điểm
    bị trội, áp quy tắc chọn w* (35). Không sửa raw/store gốc."""
    df = pd.DataFrame([raw[w] for w in ws])
    store_f = {w: store[w] for w in ws}
    L = df["Σ tổn thọ (h/ngày)"].values.astype(float)
    best_idx = list(range(len(L)))
    for k in range(1, len(L)):
        j = int(np.argmin(L[:k]))
        if L[k] > L[j] + 1e-9:
            best_idx[k] = j
    bad = [k for k in range(len(L)) if best_idx[k] != k]
    if bad:
        cols = ["Đỉnh P_sys (kW)", "LF", "Σ tổn thọ (h/ngày)", "Max θ_hs trạm bơm (°C)",
                "Nguồn lời giải (w)"]
        src = df.copy()
        for k in bad:
            df.loc[k, cols] = src.loc[best_idx[k], cols].values
            store_f[ws[k]] = store[ws[best_idx[k]]]
    base = df.iloc[0]
    df["Δ đỉnh (%)"] = ((df["Đỉnh P_sys (kW)"] - base["Đỉnh P_sys (kW)"])
                        / base["Đỉnh P_sys (kW)"] * 100).round(2)
    df["Δ tổn thọ (%)"] = ((df["Σ tổn thọ (h/ngày)"] - base["Σ tổn thọ (h/ngày)"])
                           / max(base["Σ tổn thọ (h/ngày)"], 1e-9) * 100).round(1)
    a = df["Đỉnh P_sys (kW)"].values.astype(float)
    b = df["Σ tổn thọ (h/ngày)"].values.astype(float)
    df["Bị trội"] = ["có" if any((a[j] <= a[k] and b[j] <= b[k]) and (a[j] < a[k] or b[j] < b[k])
                                 for j in range(len(df))) else "không" for k in range(len(df))]
    gain = b[0] - b
    cost = (a - a[0]) / max(a[0], 1e-9)
    nondom = np.array([v == "không" for v in df["Bị trội"]])
    # [v9.8] Chỉ chọn trong các điểm KHÔNG BỊ TRỘI (v9.7 có thể chọn điểm bị trội, ví dụ w=20 cùng
    # đỉnh nhưng tổn thọ cao hơn w=30 -> lời giải khuyến nghị nằm ngoài biên Pareto).
    afford = np.where((cost <= KNEE_PEAK_COST_CAP + 1e-12) & nondom)[0]
    if afford.size == 0:
        afford = np.where(cost <= KNEE_PEAK_COST_CAP + 1e-12)[0]
    if afford.size == 0:
        afford = np.array([0])
    target = KNEE_TARGET_FRAC * gain[afford].max()
    ok = [i for i in afford if gain[i] >= target - 1e-9]
    ki = ok[0] if ok else int(afford[int(np.argmin(b[afford]))])
    return df, store_f, ki, gain, cost, b, bad


def ageing_pareto(stations, others, pv_central, load_peak_guard, seed=SEED_MAIN):
    """
    Quét w_age trên cấu hình S3 (ĐMT trung thế, không PV áp mái) để dựng đường đánh đổi
    đỉnh <-> tổn thọ và chọn w* theo quy tắc CÔNG BỐ TRƯỚC (35):
        A = {k : (P̂_k − P̂_0)/P̂_0 <= KNEE_PEAK_COST_CAP};  G_k = L_0 − L_k
        w* = min{ w_k : k ∈ A, G_k >= KNEE_TARGET_FRAC · max_{j∈A} G_j }
    [v9 F6] Lọc biên không trội thay CẢ HÀNG. [v9.1] Nếu w* rơi vào BIÊN PHẢI mà tổn thọ vẫn
    giảm, TỰ MỞ RỘNG dải quét (tối đa AGEING_SWEEP_MAX_EXT lần) rồi chọn lại.
    """
    banner("[B3] QUÉT PARETO: ĐỈNH XUẤT TUYẾN  <->  TỔN THỌ CÁCH ĐIỆN MBA (IEC 60076-7)")
    ws, raw, store = [], {}, {}

    def solve(w):
        sc, J, ev, _ = run_optimizer(stations, others, pv_central, seed=seed, mode="full",
                                     verbose=False, w_ageing=w, load_peak_guard=load_peak_guard,
                                     effort=(AGEING_SWEEP_RUNS, AGEING_SWEEP_ITERS))
        r = ev.full(sc)
        lol = total_loss_of_life(stations, r["nets"])
        hs = max(iec_hotspot(r["nets"][c]["s_net"], st["TRs"])["theta_h_max"]
                 for c, st in stations.items() if st["P_pump"] > 0)
        pk = float(np.max(r["P_sys"]))
        raw[w] = {"w_ageing": w, "Đỉnh P_sys (kW)": round(pk, 0),
                  "LF": round(float(np.mean(r["P_sys"]) / pk), 3) if pk > 0 else 0.0,
                  "Σ tổn thọ (h/ngày)": round(lol, 2), "Max θ_hs trạm bơm (°C)": round(hs, 1),
                  "Nguồn lời giải (w)": w}
        store[w] = sc
        ws.append(w)
        print(f"   w={w:6.1f} -> đỉnh {pk:8,.0f} kW | Σ tổn thọ {lol:8.2f} h/ngày | "
              f"θ_hs,max(trạm bơm) {hs:.1f} °C")

    for w in AGEING_SWEEP:
        solve(float(w))
    n_ext = 0
    while True:
        df, store_f, ki, gain, cost, b, bad = _pareto_table(ws, raw, store)
        at_edge = ki == len(ws) - 1 and len(ws) > 1 and b[-1] < b[-2] - 1e-9
        if not at_edge or n_ext >= AGEING_SWEEP_MAX_EXT:
            break
        new = [round(ws[-1] * 1.6, 1), round(ws[-1] * 2.5, 1)]
        print(f"   [i] w* rơi vào biên phải (w = {ws[-1]:g}) và tổn thọ vẫn giảm -> mở rộng dải quét "
              f"thêm {new}")
        for w in new:
            solve(w)
        n_ext += 1

    if bad:
        print("\n [!] Đường Pareto KHÔNG ĐƠN ĐIỆU tại w = "
              + ", ".join(f"{ws[k]:g}" for k in bad) + " (nhiễu tìm kiếm ngẫu nhiên).")
        print("     Đã thay CẢ HÀNG bằng lời giải tốt nhất ở w nhỏ hơn (cột 'Nguồn lời giải').")
    print("\n" + df.to_string(index=False))
    print(" [i] 'Bị trội' = có: tồn tại điểm khác đỉnh không cao hơn VÀ tổn thọ không cao hơn (một")
    print("     trong hai nhỏ hơn hẳn) -> không nằm trên biên Pareto, không chọn làm điểm vận hành.")
    knee = float(ws[ki])
    print(f"\n [+] w* = {knee:g}  (quy tắc công bố trước: w nhỏ nhất đạt "
          f"{KNEE_TARGET_FRAC:.0%} mức giảm tổn thọ lớn nhất trong các w làm đỉnh tăng <= "
          f"{KNEE_PEAK_COST_CAP:.0%})")
    print(f"     Giảm tổn thọ {gain[ki]/max(b[0],1e-9)*100:.1f}% với chi phí đỉnh "
          f"{cost[ki]*100:+.2f}%")
    if gain[ki] <= 1e-9:
        print("     [!] Không có mức giảm tổn thọ nào trong ngưỡng chi phí đỉnh -> S3A trùng S3.")
    if ki == len(ws) - 1 and len(ws) > 1 and b[-1] < b[-2] - 1e-9:
        print("     [!] Sau khi mở rộng, w* VẪN ở biên phải và tổn thọ còn giảm: báo cáo trong bài rằng")
        print("         dải quét chưa bão hoà; tăng AGEING_SWEEP_MAX_EXT nếu cần.")
    print("\n Hiệu quả biên (điểm % giảm tổn thọ trên mỗi điểm % đỉnh phải trả):")
    for i in range(1, len(ws)):
        c_, g_ = cost[i] * 100, gain[i] / max(b[0], 1e-9) * 100
        eff = "không tốn đỉnh" if c_ <= 1e-6 else f"{g_ / c_:6.1f}"
        print(f"   w={ws[i]:6g}: giảm {g_:5.1f}% | đỉnh {c_:+5.2f}% | hiệu quả {eff}")
    print(" [i] Giá trị w không có ý nghĩa tuyệt đối (phụ thuộc thang của Σ S² và Σ L/24); bài báo")
    print("     nên báo cáo mức đánh đổi (% đỉnh, % tổn thọ), không nhấn vào con số w.")
    return df, store_f, knee


def pick_ageing_solution(cands, ev_w, stations, others, pv_cen, peak_ref, pv_roof=None,
                         fallback=None, tag=""):
    """[v9.1] Chọn lời giải có xét tổn thọ: trong các ứng viên có đỉnh xuất tuyến KHÔNG vượt
    (1 + KNEE_PEAK_COST_CAP)·peak_ref - đúng trần đã dùng để chọn w* - lấy J(w*) nhỏ nhất.
    Không ứng viên nào thoả trần -> dùng fallback (lời giải không xét tổn thọ)."""
    lim = peak_ref * (1.0 + KNEE_PEAK_COST_CAP) + 0.5
    rows, ok = [], []
    for name, s in cands:
        pk = float(np.max(feeder_profile(stations, others, s, pv_cen, pv_roof)[0]))
        J = ev_w.full(s)["J"]
        rows.append((name, pk, J, pk <= lim))
        if pk <= lim:
            ok.append((J, name, s))
    for name, pk, J, good in rows:
        print(f"     {tag} ứng viên '{name}': đỉnh {pk:,.0f} kW ({(pk/peak_ref-1)*100:+.2f}%), "
              f"J(w*) = {J:.4f} -> {'thoả trần' if good else 'VƯỢT trần đỉnh, loại'}")
    if ok:
        ok.sort(key=lambda z: z[0])
        print(f"     -> {tag} chọn '{ok[0][1]}'.")
        return ok[0][2]
    print(f"     [!] {tag}: không ứng viên nào thoả trần đỉnh -> dùng lời giải không xét tổn thọ.")
    return {c: v.copy() for c, v in fallback.items()}


