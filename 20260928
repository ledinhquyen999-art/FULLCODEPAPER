def series_fingerprint(a):
    """
    [N3] Đặc tính chuỗi số liệu - CHỈ BÁO CÁO, không thay đổi dữ liệu.
    Dùng để mô tả chính xác nguồn số liệu trong mục Data của bài báo.
    """
    a = np.asarray(a, float)
    uniq = len(np.unique(np.round(a, 9)))
    paired = bool(np.all([abs(a[2 * i] - a[2 * i + 1]) < 1e-12 for i in range(len(a) // 2)]))
    d = np.diff(a)
    nz = np.abs(d[np.abs(d) > 1e-12])
    return {"n_unique": uniq, "paired_consecutive": paired,
            "n_changes": int(np.sum(np.abs(d) > 1e-12)),
            "min_step": float(nz.min()) if nz.size else 0.0}


def read_etap_series(path):
    """
    Đọc P (kW), Q (kvar) 48 điểm. Trả thêm:
      has_q  : file có cột Q thực hay không
      meta   : Sđm/Pđm đọc từ file (nếu có) + đặc tính chuỗi (N2, N3)
    LƯU Ý: chương trình KHÔNG ghi đè và KHÔNG sửa dữ liệu gốc; Sđm/Pđm chỉ dùng để ĐỐI CHIẾU.
    """
    xl = pd.ExcelFile(path)
    df = pd.read_excel(path, sheet_name=xl.sheet_names[0])
    cols = {c.strip().lower(): c for c in df.columns}
    p_col = next((cols[k] for k in cols if k.startswith("p(")), None)
    q_col = next((cols[k] for k in cols if k.startswith("q(")), None)
    if p_col is None:
        raise ValueError(f"Khong tim thay cot P trong {os.path.basename(path)}")

    meta = {"file": os.path.basename(path), "Sdm_kVA": None, "Pdm_kW": None, "n_rows": len(df)}
    for c in df.columns:
        lc = str(c).strip().lower()
        if lc.startswith("sđm") or lc.startswith("sdm"):
            v = pd.to_numeric(df[c], errors="coerce").dropna()
            if len(v):
                meta["Sdm_kVA"] = float(v.iloc[0]) * 1000.0
        if lc.startswith("pđm") or lc.startswith("pdm"):
            v = pd.to_numeric(df[c], errors="coerce").dropna()
            if len(v):
                meta["Pdm_kW"] = float(v.iloc[0]) * 1000.0

    if "hour" in cols and "min" in cols:
        df = df[df[cols["min"]].isin([0, 30])].copy()
        df = df.sort_values([cols["hour"], cols["min"]])
        df = df.drop_duplicates(subset=[cols["hour"], cols["min"]], keep="first")

    p = df[p_col].values.astype(float) * 1000.0
    has_q = q_col is not None and USE_MEASURED_Q
    q = (df[q_col].values.astype(float) * 1000.0) if has_q else p * Q_P_RATIO

    def fit(a):
        a = np.asarray(a, float)
        if len(a) == N_SLOTS:
            return a
        if len(a) > N_SLOTS:
            return a[:N_SLOTS]
        src = np.linspace(0.0, 1.0, len(a) + 1)
        dst = np.linspace(0.0, 1.0, N_SLOTS, endpoint=False)
        return np.interp(dst, src, np.append(a, a[0]))

    p, q = fit(p), fit(q)
    meta["fp_P"] = series_fingerprint(p)
    meta["fp_Q"] = series_fingerprint(q)
    s_all = np.hypot(p, q)
    with np.errstate(divide="ignore", invalid="ignore"):
        cosphi = np.where(s_all > 1e-9, p / np.maximum(s_all, 1e-9), np.nan)
    meta["cosphi_std"] = float(np.nanstd(cosphi))
    meta["cosphi_min"] = float(np.nanmin(cosphi))
    meta["cosphi_max"] = float(np.nanmax(cosphi))
    meta["P_max"] = float(np.max(p))
    meta["S_max"] = float(np.max(s_all))
    return p, q, bool(has_q), meta


def _read_table(path):
    return pd.read_csv(path) if path.lower().endswith("csv") else pd.read_excel(path)


def _pick_col(df, keys):
    for c in df.columns:
        if c.strip().lower() in keys:
            return c
    for c in df.columns:
        for k in keys:
            if k in c.strip().lower():
                return c
    return None


